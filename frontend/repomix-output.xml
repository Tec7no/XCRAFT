                                            <input required placeholder="Full Name" className="w-full bg-muted border border-border p-3 rounded text-sm outline-none focus:border-secondary" onChange={e => setNewAddress({ ...newAddress, fullName: e.target.value })} />
                                            <input required placeholder="Phone Number" className="w-full bg-muted border border-border p-3 rounded text-sm outline-none focus:border-secondary" onChange={e => setNewAddress({ ...newAddress, phone: e.target.value })} />
                                            <input required placeholder="Address (Street, Building)" className="w-full bg-muted border border-border p-3 rounded text-sm outline-none focus:border-secondary" onChange={e => setNewAddress({ ...newAddress, address: e.target.value })} />
                                            <input required placeholder="City" className="w-full bg-muted border border-border p-3 rounded text-sm outline-none focus:border-secondary" onChange={e => setNewAddress({ ...newAddress, city: e.target.value })} />
                                            <div className="flex gap-4 pt-4">
