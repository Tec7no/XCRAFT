                    </div>

                    <Separator className="bg-[#d8c6bb]/50" />

                    {/* Price */}
                    <div className="space-y-4">
                        <div className="flex items-center justify-between">
                            <Label className="text-sm font-bold text-[#3a2d23] uppercase">{t("filters_price")}</Label>
                            <span className="text-xs text-[#3a2d23]/70 font-mono">
