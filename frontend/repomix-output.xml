st t = React.useCallback(\r\n        (key: string): string => {\r\n            // Priority 1: Admin Site Settings (with safe access)\r\n            const customTranslation = settings?.translations?.[lang]?.[key];\r\n            if (customTranslation) {\r\n                return customTranslation;\r\n            }\r\n            // Priority 2: Static file translations\r\n            return translations[lang]?.[key] || key;\r\n        },\r\n        [lang, settings]\r\n    );\r\n\r\n    return (\r\n        <LanguageContext.Provider value={{ lang, setLang, toggleLang, t }}>\r\n            {children}\r\n        </LanguageContext.Provider>\r\n    );\r\n};\r\n\r\nexport const useLanguage = (): LanguageContextType => {\r\n    const context = React.useContext(LanguageContext);\r\n    if (!context) {\r\n        throw new Error('useLanguage must be used within a LanguageProvider');\r\n    }\r\n    return context;\r\n};\r\n","usedDeprecatedRules":[]},{"filePath":"E:\\NON COGNITIVE SIDE\\ready-deploy-site-main\\ready-deploy-site-main\\src\\lib\\utils.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"E:\\NON COGNITIVE SIDE\\ready-deploy-site-main\\ready-deploy-site-main\\src\\main.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"E:\\NON COGNITIVE SIDE\\ready-deploy-site-main\\ready-deploy-site-main\\src\\pages\\AdminPage.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"E:\\NON COGNITIVE SIDE\\ready-deploy-site-main\\ready-deploy-site-main\\src\\pages\\Checkout.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":198,"column":35,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":198,"endColumn":38,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[8159,8162],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[8159,8162],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from 'react';\r\nimport { useNavigate } from 'react-router-dom';\r\nimport { useStorageState } from '@/utils/storage';\r\nimport { CartItem, Product, Order, OrderItem, PaymentMethod, CustomerInfo, PaymentInfo, User, Discount } from '@/types';\r\nimport { useLanguage } from '@/i18n/LanguageContext';\r\nimport { Button } from '@/components/ui/button';\r\nimport { ArrowLeft, ArrowRight, CreditCard, Building2, Truck, Upload, AlertCircle, CheckCircle } from 'lucide-react';\r\nimport { useToast } from '@/hooks/use-toast';\r\nimport { createOrder } from '@/utils/ordersStore';\r\nimport { validateStock, decrementStock } from '@/utils/stockUtils';\r\nimport CreditCardForm from '@/components/CreditCardForm';\r\nimport { processPayment, CardDetails } from '@/services/payment';\r\n\r\nexport default function Checkout() {\r\n    const navigate = useNavigate();\r\n    const { t, lang } = useLanguage();\r\n    const { toast } = useToast();\r\n    const dir = lang === 'ar' ? 'rtl' : 'ltr';\r\n\r\n    // Access global state\r\n    const [cart, setCart] = useStorageState<CartItem[]>('cart', []);\r\n    const [products, setProducts] = useStorageState<Product[]>('products', []);\r\n    const [user] = useStorageState<User | null>('user', null);\r\n    const [discounts] = useStorageState<Discount[]>('discounts', []);\r\n\r\n    // Form state\r\n    const [customerInfo, setCustomerInfo] = React.useState<CustomerInfo>({\r\n        fullName: '',\r\n        phone: '',\r\n        email: '',\r\n        address: '',\r\n        city: '',\r\n    });\r\n    const [paymentMethod, setPaymentMethod] = React.useState<PaymentMethod>('cod');\r\n    const [proofImage, setProofImage] = React.useState<string>('');\r\n    const [isSubmitting, setIsSubmitting] = React.useState(false);\r\n    const [errors, setErrors] = React.useState<Record<string, string>>({});\r\n\r\n    const [promoCode, setPromoCode] = React.useState('');\r\n    const [appliedDiscount, setAppliedDiscount] = React.useState<Discount | null>(null);\r\n    const [saveAddress, setSaveAddress] = React.useState(false);\r\n\r\n    // Payment State\r\n    const [cardDetails, setCardDetails] = React.useState<CardDetails | null>(null);\r\n    const [isCardValid, setIsCardValid] = React.useState(false);\r\n\r\n    // Calculate totals\r\n    const subtotal = cart.reduce((acc, item) => acc + item.salePrice * item.quantity, 0);\r\n\r\n    const discountAmount = React.useMemo(() => {\r\n        if (!appliedDiscount) return 0;\r\n        if (appliedDiscount.minOrderAmount && subtotal < appliedDiscount.minOrderAmount) return 0;\r\n\r\n        if (appliedDiscount.type === 'percentage') {\r\n            return Math.min(subtotal, (subtotal * appliedDiscount.value) / 100);\r\n        } else {\r\n            return Math.min(subtotal, appliedDiscount.value);\r\n        }\r\n    }, [appliedDiscount, subtotal]);\r\n\r\n    const delivery = 0; // FREE Shipping\r\n    const total = Math.max(0, subtotal - discountAmount + delivery);\r\n\r\n    const handleApplyCoupon = () => {\r\n        const found = discounts.find(d => d.code === promoCode.trim().toUpperCase() && d.active);\r\n        if (!found) {\r\n            toast({ title: \"Invalid Coupon\", description: \"This code does not exist or is inactive.\", variant: \"destructive\" });\r\n            return;\r\n        }\r\n        if (found.minOrderAmount && subtotal < found.minOrderAmount) {\r\n            toast({ title: \"Requirements Not Met\", description: `Order must be at least ${found.minOrderAmount} EGP.`, variant: \"destructive\" });\r\n            return;\r\n        }\r\n        setAppliedDiscount(found);\r\n        toast({ title: \"Coupon Applied!\", description: `You saved with ${found.code}` });\r\n    };\r\n\r\n    // Validate form\r\n    const validateForm = (): boolean => {\r\n        const newErrors: Record<string, string> = {};\r\n\r\n        if (!customerInfo.fullName.trim()) newErrors.fullName = 'Full name is required';\r\n        if (!customerInfo.phone.trim()) newErrors.phone = 'Phone number is required';\r\n        if (!customerInfo.address.trim()) newErrors.address = 'Address is required';\r\n        if (!customerInfo.city.trim()) newErrors.city = 'City is required';\r\n\r\n        if (paymentMethod === 'transfer' && !proofImage) {\r\n            newErrors.proof = 'Payment proof is required for bank transfer';\r\n        }\r\n\r\n        setErrors(newErrors);\r\n        return Object.keys(newErrors).length === 0;\r\n    };\r\n\r\n    // Handle proof image upload\r\n    const handleProofUpload = (e: React.ChangeEvent<HTMLInputElement>) => {\r\n        const file = e.target.files?.[0];\r\n        if (!file) return;\r\n\r\n        if (!file.type.startsWith('image/')) {\r\n            toast({ title: 'Error', description: 'Please upload an image file', variant: 'destructive' });\r\n            return;\r\n        }\r\n\r\n        if (file.size > 5 * 1024 * 1024) { // 5MB limit\r\n            toast({ title: 'Error', description: 'Image must be less than 5MB', variant: 'destructive' });\r\n            return;\r\n        }\r\n\r\n        const reader = new FileReader();\r\n        reader.onloadend = () => {\r\n            setProofImage(reader.result as string);\r\n            setErrors(prev => ({ ...prev, proof: '' }));\r\n        };\r\n        reader.readAsDataURL(file);\r\n    };\r\n\r\n    // Handle checkout submission\r\n    const handleSubmit = async () => {\r\n        if (!validateForm()) return;\r\n\r\n        // Validate stock availability\r\n        const stockValidation = validateStock(cart, products);\r\n        if (!stockValidation.valid) {\r\n            toast({\r\n                title: 'Stock Issue',\r\n                description: stockValidation.errors.join('\\n'),\r\n                variant: 'destructive',\r\n            });\r\n            return;\r\n        }\r\n\r\n        setIsSubmitting(true);\r\n\r\n        // Simulate API delay (no longer needed for card, but kept for others or just remove)\r\n        // setTimeout(() => {\r\n        try {\r\n            // 0. Process Payment if Card\r\n            let transactionId = undefined;\r\n            let maskedCard = undefined;\r\n\r\n            if (paymentMethod === 'card') {\r\n                if (!cardDetails || !isCardValid) {\r\n                    toast({ title: 'Invalid Card', description: 'Please check your card details.', variant: 'destructive' });\r\n                    setIsSubmitting(false);\r\n                    return;\r\n                }\r\n\r\n                const result = await processPayment(total, cardDetails);\r\n\r\n                if (!result.success) {\r\n                    toast({ title: 'Payment Failed', description: result.error || 'Transaction declined.', variant: 'destructive' });\r\n                    setIsSubmitting(false);\r\n                    return;\r\n                }\r\n\r\n                transactionId = result.transactionId;\r\n                maskedCard = `**** **** **** ${cardDetails.number.slice(-4)}`;\r\n            }\r\n\r\n            // 1. Create order items from cart\r\n            const orderItems: OrderItem[] = cart.map(item => ({\r\n                productId: item.id,\r\n                name: item.name,\r\n                code: item.code,\r\n                image: item.images[0] || '',\r\n                size: item.selectedSize,\r\n                color: item.selectedColor,\r\n                colorName: item.colors.find(c => c.hex === item.selectedColor)?.name,\r\n                quantity: item.quantity,\r\n                unitPrice: item.salePrice,\r\n                lineTotal: item.salePrice * item.quantity,\r\n            }));\r\n\r\n            // 2. Create payment info\r\n            const payment: PaymentInfo = {\r\n                method: paymentMethod,\r\n                proofImage: paymentMethod === 'transfer' ? proofImage : undefined,\r\n                transactionId,\r\n                maskedCard,\r\n                cardBrand: 'Visa' // Mock detection for now\r\n            };\r\n\r\n            // 3. Create order via store\r\n            const order = createOrder({\r\n                items: orderItems,\r\n                customer: customerInfo,\r\n                payment,\r\n                subtotal,\r\n                discount: discountAmount,\r\n                delivery,\r\n                total,\r\n                status: 'pending_review',\r\n            });\r\n\r\n            // 3.5 Save Address if requested\r\n            if (saveAddress && user) {\r\n                const newAddress: any = { // using any to avoid type hurdles for now\r\n                    id: crypto.randomUUID(),\r\n                    name: \"New Address \" + (user.addresses?.length || 0 + 1),\r\n                    fullName: customerInfo.fullName,\r\n                    phone: customerInfo.phone,\r\n                    address: customerInfo.address,\r\n                    city: customerInfo.city,\r\n                    isDefault: false\r\n                };\r\n\r\n                // We need to update the User in storage. \r\n                // Since 'user' state is from hook, we might need a way to update it.\r\n                // But 'user' here is just the value. We need the setter or to manually update storage.\r\n                // Since we can't easily access setUser here without refactoring, \r\n                // we will modify the localStorage directly or use a helper event.\r\n                // Better approach: We have 'user' value, let's create updated object and save it.\r\n\r\n                const updatedUser = {\r\n                    ...user,\r\n                    addresses: [...(user.addresses || []), newAddress]\r\n                };\r\n\r\n                // Update user storage manually to ensure persistence\r\n                localStorage.setItem('townteam_user', JSON.stringify(updatedUser));\r\n\r\n                // Dispatch storage event to update other components\r\n                window.dispatchEvent(new Event('storage'));\r\n            }\r\n\r\n            // 4. Decrement stock\r\n            const updatedProducts = decrementStock(cart, products);\r\n            setProducts(updatedProducts);\r\n\r\n            // 5. Clear cart\r\n            setCart([]);\r\n\r\n            // 6. Success feedback\r\n            toast({\r\n                title: 'Order Placed Successfully!',\r\n                description: `Thank you! Your order #${order.id} is being reviewed.`,\r\n            });\r\n\r\n            // 7. Redirect to confirmation\r\n            navigate(`/order-confirmation?orderId=${order.id}`);\r\n        } catch (error) {\r\n            console.error('Checkout error:', error);\r\n            toast({\r\n                title: 'Error',\r\n                description: 'Something went wrong. Please try again.',\r\n                variant: 'destructive',\r\n            });\r\n        } finally {\r\n            setIsSubmitting(false);\r\n        }\r\n    };\r\n\r\n    if (cart.length === 0) {\r\n        return (\r\n            <div className=\"min-h-screen flex flex-col items-center justify-center bg-[#f6efea] p-4 text-center\">\r\n                <CheckCircle className=\"w-16 h-16 text-green-500 mb-4\" />\r\n                <h2 className=\"text-2xl font-bold text-[#3a2d23] mb-2\">Your cart is empty</h2>\r\n                <p className=\"text-[#3a2d23]/70 mb-6\">Looks like you haven't added anything yet.</p>\r\n                <Button onClick={() => navigate('/')} className=\"bg-[#3a2d23] text-white\">\r\n                    Continue Shopping\r\n                </Button>\r\n            </div>\r\n        );\r\n    }\r\n\r\n    return (\r\n        <div className=\"min-h-screen bg-[#f6efea] py-8 px-4\" dir={dir}>\r\n            <div className=\"max-w-5xl mx-auto\">\r\n                {/* Header */}\r\n                <Button\r\n                    variant=\"ghost\"\r\n                    onClick={() => navigate('/')}\r\n                    className=\"mb-6 hover:bg-transparent hover:text-[#b1121a] p-0 flex gap-2\"\r\n                >\r\n                    {dir === 'rtl' ? <ArrowRight className=\"w-4 h-4\" /> : <ArrowLeft className=\"w-4 h-4\" />}\r\n                    Back to Shop\r\n                </Button>\r\n\r\n                <h1 className=\"text-3xl font-black text-[#3a2d23] uppercase tracking-tight mb-8\">Checkout</h1>\r\n\r\n                <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-8\">\r\n                    {/* Left: Forms */}\r\n                    <div className=\"lg:col-span-2 space-y-6\">\r\n                        {/* Customer Information */}\r\n                        <div className=\"bg-white p-6 rounded-lg shadow-sm border border-[#d8c6bb]\">\r\n                            <div className=\"flex justify-between items-center mb-4\">\r\n                                <h3 className=\"text-sm font-black uppercase tracking-widest text-[#3a2d23]\">\r\n                                    Customer Information\r\n                                </h3>\r\n                                {user?.addresses && user.addresses.length > 0 && (\r\n                                    <div className=\"mb-6 grid grid-cols-1 sm:grid-cols-2 gap-3\">\r\n                                        {user.addresses.map(a => (\r\n                                            <div\r\n                                                key={a.id}\r\n                                                onClick={() => {\r\n                                                    setCustomerInfo({\r\n                                                        ...customerInfo,\r\n                                                        fullName: a.fullName,\r\n                                                        phone: a.phone,\r\n                                                        address: a.address,\r\n                                                        city: a.city\r\n                                                    });\r\n                                                }}\r\n                                                className={`\r\n                                                    border rounded-lg p-3 cursor-pointer transition-all relative\r\n                                                    ${customerInfo.address === a.address\r\n                                                        ? 'border-[#b1121a] bg-[#b1121a]/5 ring-1 ring-[#b1121a]'\r\n                                                        : 'border-[#d8c6bb] hover:border-[#b1121a]/50 bg-white'\r\n                                                    }\r\n                                                `}\r\n                                            >\r\n                                                <div className=\"flex justify-between items-start\">\r\n                                                    <div>\r\n                                                        <p className=\"font-bold text-xs uppercase tracking-wide text-[#3a2d23] mb-1 flex items-center gap-2\">\r\n                                                            {customerInfo.address === a.address && <CheckCircle className=\"w-3 h-3 text-[#b1121a]\" />}\r\n                                                            {a.name}\r\n                                                        </p>\r\n                                      