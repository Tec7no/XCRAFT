            <main className="">
                {/* --- 1. Cinematic Hero Slider --- */}
                <EditableSection id="hero" title="Hero Section">
                    <WebGLHero onNavigate={(cat) => navigate(cat ? `/shop/${cat}` : '/shop')} />
