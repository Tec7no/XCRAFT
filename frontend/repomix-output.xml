<file path="src/components/ui/editable-image.tsx">
import React, { useState } from "react";
import { useEditMode } from "@/admin/EditModeContext";
import { useSiteSettings } from "@/config/SiteSettingsContext";
import { Popover, PopoverContent, PopoverTrigger } from "@/components/ui/popover";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Check, X, Image as ImageIcon } from "lucide-react";

interface EditableImageProps {
    path: (string | number)[];
    alt?: string;
    className?: string;
}

// Helper to get nested value
function getNestedValue(obj: any, path: (string | number)[]): any {
    return path.reduce((acc, key) => acc?.[key], obj);
}

// Helper to set nested value immutably
function setNestedValue(obj: any, path: (string | number)[], value: any): any {
    if (path.length === 0) return value;
    const [head, ...rest] = path;
    const current = obj?.[head];
    return {
        ...obj,
        [head]: rest.length === 0 ? value : setNestedValue(current, rest, value),
    };
}

export function EditableImage({ path, alt = "Image", className = "" }: EditableImageProps) {
    const { isEditMode, canEdit } = useEditMode();
    const { settings, updateSettings } = useSiteSettings();
    const [isOpen, setIsOpen] = useState(false);
    const [draft, setDraft] = useState("");

    const currentValue = getNestedValue(settings, path) || "";

    const handleOpen = () => {
        setDraft(currentValue);
        setIsOpen(true);
    };

    const handleSave = () => {
        updateSettings((prev) => setNestedValue(prev, path, draft));
        setIsOpen(false);
    };

    const handleCancel = () => {
        setIsOpen(false);
    };

    // HARD PROTECTION: Normal mode for non-admins or when edit mode is off
    if (!isEditMode || !canEdit) {
        return (
            <img
                src={currentValue}
                alt={alt}
                className={className}
                loading="lazy"
                decoding="async"
            />
        );
    }

    // Edit mode
    return (
        <Popover open={isOpen} onOpenChange={setIsOpen}>
            <PopoverTrigger asChild>
                <div
                    className={`relative cursor-pointer group ${className}`}
                    onClick={handleOpen}
                >
                    <img
                        src={currentValue}
                        alt={alt}
                        className="w-full h-full object-cover"
                        loading="lazy"
                        decoding="async"
                    />
                    <div className="absolute inset-0 border-2 border-dashed border-transparent group-hover:border-[var(--ic-primary)] transition-all flex items-center justify-center">
                        <div className="opacity-0 group-hover:opacity-100 bg-black/60 text-white px-2 py-1 rounded text-xs font-bold flex items-center gap-1 transition-opacity">
                            <ImageIcon className="h-3 w-3" /> Edit
                        </div>
                    </div>
                </div>
            </PopoverTrigger>
            <PopoverContent className="w-80 p-4 z-[9999]" align="start">
                <div className="space-y-3">
                    <p className="text-xs font-mono text-muted-foreground">Image URL</p>
                    <Input
                        value={draft}
                        onChange={(e) => setDraft(e.target.value)}
                        placeholder="https://..."
                        className="text-sm"
                    />
                    {draft && (
                        <div className="w-full h-20 rounded overflow-hidden border">
                            <img src={draft} alt="Preview" className="w-full h-full object-cover" />
                        </div>
                    )}
                    <div className="flex gap-2 justify-end">
                        <Button size="sm" variant="ghost" onClick={handleCancel}>
                            <X className="h-4 w-4 mr-1" /> Cancel
                        </Button>
                        <Button size="sm" onClick={handleSave} className="bg-[var(--ic-primary)] hover:bg-[var(--ic-primary-hover)]">
                            <Check className="h-4 w-4 mr-1" /> Save
                        </Button>
                    </div>
                </div>
            </PopoverContent>
        </Popover>
    );
}
</file>

<file path="src/components/ui/editable-section.tsx">
import React from "react";
import { useEditMode } from "@/admin/EditModeContext";
import { useSiteSettings } from "@/config/SiteSettingsContext";
import { Eye, EyeOff, Settings } from "lucide-react";

interface EditableSectionProps {
    id: string;
    title: string;
    children: React.ReactNode;
}

export function EditableSection({ id, title, children }: EditableSectionProps) {
    const { isEditMode, canEdit } = useEditMode();
    const { settings, updateSettings } = useSiteSettings();

    // Get visibility from settings (default to true if not set)
    const sectionKey = `${id}Visible`;
    const sections = settings.featureFlags?.sections as Record<string, boolean> | undefined;
    const isVisible = sections?.[sectionKey] ?? true;

    const toggleVisibility = () => {
        updateSettings((prev) => ({
            ...prev,
            featureFlags: {
                ...prev.featureFlags,
                sections: {
                    ...prev.featureFlags?.sections,
                    [sectionKey]: !isVisible,
                },
            },
        }));
    };

    // If hidden and not in edit mode, don't render
    if (!isVisible && !isEditMode) {
        return null;
    }

    // HARD PROTECTION: Normal mode for non-admins or when edit mode is off
    if (!isEditMode || !canEdit) {
        return <>{children}</>;
    }

    // Edit mode - show toolbar and potentially hidden indicator
    return (
        <div className={`relative ${!isVisible ? "opacity-40" : ""}`}>
            {/* Floating toolbar */}
            <div className="absolute top-2 right-2 z-50 flex items-center gap-1 bg-white/95 border border-[var(--ic-border)] rounded-lg shadow-lg px-2 py-1">
                <span className="text-xs font-bold text-[var(--ic-text)] mr-2">{title}</span>
                <button
                    onClick={toggleVisibility}
                    className={`p-1.5 rounded transition-colors ${isVisible
                        ? "text-green-600 hover:bg-green-50"
                        : "text-red-500 hover:bg-red-50"
                        }`}
                    title={isVisible ? "Hide section" : "Show section"}
                >
                    {isVisible ? <Eye className="h-4 w-4" /> : <EyeOff className="h-4 w-4" />}
                </button>
            </div>

            {/* Hidden overlay */}
            {!isVisible && (
                <div className="absolute inset-0 bg-red-500/10 border-2 border-dashed border-red-300 flex items-center justify-center z-40 pointer-events-none">
                    <span className="bg-red-500 text-white px-3 py-1 rounded-full text-xs font-bold">
                        Hidden
                    </span>
                </div>
            )}

            {/* Content */}
            {children}
        </div>
    );
}
</file>

<file path="src/components/ui/editable-text.tsx">
import React, { useState } from "react";
import { useEditMode } from "@/admin/EditModeContext";
import { useSiteSettings } from "@/config/SiteSettingsContext";
import { useLanguage } from "@/i18n/LanguageContext";
import { Popover, PopoverContent, PopoverTrigger } from "@/components/ui/popover";
import { Button } from "@/components/ui/button";
import { Textarea } from "@/components/ui/textarea";
import { Check, X, RotateCcw } from "lucide-react";

interface EditableTextProps {
    k: string;
    defaultValue?: string;
    as?: "p" | "span" | "h1" | "h2" | "h3" | "div";
    className?: string;
    children?: React.ReactNode;
}

export function EditableText({ k, defaultValue, as: Tag = "span", className = "" }: EditableTextProps) {
    const { isEditMode, canEdit } = useEditMode();
    const { settings, updateSettings } = useSiteSettings();
    const { t, lang } = useLanguage();
    const [isOpen, setIsOpen] = useState(false);
    const [fontSize, setFontSize] = useState<string>("");
    const [draft, setDraft] = useState("");

    // Check if there's an override for this key
    const hasOverride = Boolean(settings.translations?.[lang]?.[k]);
    // Use override -> t(k) -> defaultValue -> k
    const currentValue = settings.translations?.[lang]?.[k] || (t(k) !== k ? t(k) : (defaultValue || k));

    // Check for visual overrides
    const visualOverride = settings.visualOverrides?.[k];
    const currentFontSize = visualOverride?.fontSize;

    const handleOpen = () => {
        setDraft(currentValue);
        setFontSize(currentFontSize || "");
        setIsOpen(true);
    };

    const handleSave = () => {
        updateSettings((prev) => ({
            ...prev,
            translations: {
                ...prev.translations,
                [lang]: {
                    ...prev.translations[lang],
                    [k]: draft,
                },
            },
            visualOverrides: {
                ...prev.visualOverrides,
                [k]: {
                    ...prev.visualOverrides?.[k],
                    ...(fontSize ? { fontSize } : {}),
                }
            }
        }));
        setIsOpen(false);
    };

    const handleReset = () => {
        // Remove the override for this key, reverting to default translation and style
        updateSettings((prev) => {
            const langTranslations = { ...prev.translations[lang] };
            delete langTranslations[k];

            const newVisualOverrides = { ...prev.visualOverrides };
            delete newVisualOverrides[k];

            return {
                ...prev,
                translations: {
                    ...prev.translations,
                    [lang]: langTranslations,
                },
                visualOverrides: newVisualOverrides,
            };
        });
        setIsOpen(false);
    };

    const handleCancel = () => {
        setIsOpen(false);
    };

    // HARD PROTECTION: Normal mode for non-admins or when edit mode is off
    if (!isEditMode || !canEdit) {
        return <Tag className={className} style={{ fontSize: currentFontSize }}>{currentValue}</Tag>;
    }

    // Edit mode
    return (
        <Popover open={isOpen} onOpenChange={setIsOpen}>
            <PopoverTrigger asChild>
                <Tag
                    className={`${className} cursor-pointer hover:outline hover:outline-2 hover:outline-dashed hover:outline-[var(--ic-primary)] transition-all`}
                    onClick={handleOpen}
                    style={{ fontSize: currentFontSize }}
                >
                    {currentValue}
                </Tag>
            </PopoverTrigger>
            <PopoverContent className="w-80 p-4 z-[9999]" align="start">
                <div className="space-y-4">
                    <div className="space-y-1.5">
                        <div className="flex justify-between items-center">
                            <p className="text-xs font-mono text-muted-foreground">{k}</p>
                            <span className="text-[10px] uppercase font-bold text-muted-foreground">Content</span>
                        </div>
                        <Textarea
                            value={draft}
                            onChange={(e) => setDraft(e.target.value)}
                            className="min-h-[80px] text-sm"
                            dir={lang === "ar" ? "rtl" : "ltr"}
                        />
                    </div>

                    <div className="space-y-1.5 pt-2 border-t">
                        <div className="flex justify-between items-center">
                            <span className="text-[10px] uppercase font-bold text-muted-foreground">Text Size</span>
                            <span className="text-xs font-mono">{fontSize || 'Default'}</span>
                        </div>
                        <div className="flex gap-2 items-center">
                            <input
                                type="range"
                                min="12"
                                max="128"
                                step="1"
                                value={parseInt(fontSize || "16")}
                                onChange={(e) => setFontSize(`${e.target.value}px`)}
                                className="flex-1 cursor-pointer"
                            />
                        </div>
                    </div>

                    <div className="flex gap-2 justify-end pt-2">
                        <Button size="sm" variant="ghost" onClick={handleCancel}>
                            <X className="h-4 w-4 mr-1" /> Cancel
                        </Button>
                        {(hasOverride || visualOverride) && (
                            <Button size="sm" variant="outline" onClick={handleReset} title="Revert to default">
                                <RotateCcw className="h-4 w-4 mr-1" /> Reset
                            </Button>
                        )}
