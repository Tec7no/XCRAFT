tCustomerInfo(prev => ({ ...prev, phone: e.target.value }))}\r\n                                        className={`w-full p-3 border rounded text-sm ${errors.phone ? 'border-red-500' : 'border-[#d8c6bb]'} focus:border-[#b1121a] outline-none`}\r\n                                        placeholder=\"+20 1xx xxx xxxx\"\r\n                                    />\r\n                                    {errors.phone && <p className=\"text-red-500 text-[10px] mt-1\">{errors.phone}</p>}\r\n                                </div>\r\n                                <div className=\"md:col-span-2\">\r\n                                    <label className=\"text-[10px] font-bold uppercase text-[#3a2d23]/60 block mb-1\">Email (Optional)</label>\r\n                                    <input\r\n                                        type=\"email\"\r\n                                        value={customerInfo.email}\r\n                                        // Auto-fill from user if logged in and empty\r\n                                        onFocus={() => { if (!customerInfo.email && user?.email) setCustomerInfo(prev => ({ ...prev, email: user.email })) }}\r\n                                        onChange={e => setCustomerInfo(prev => ({ ...prev, email: e.target.value }))}\r\n                                        className=\"w-full p-3 border border-[#d8c6bb] rounded text-sm focus:border-[#b1121a] outline-none\"\r\n                                        placeholder=\"john@example.com\"\r\n                                    />\r\n                                </div>\r\n                                <div className=\"md:col-span-2\">\r\n                                    <label className=\"text-[10px] font-bold uppercase text-[#3a2d23]/60 block mb-1\">Address *</label>\r\n                                    <input\r\n                                        type=\"text\"\r\n                                        value={customerInfo.address}\r\n                                        onChange={e => setCustomerInfo(prev => ({ ...prev, address: e.target.value }))}\r\n                                        className={`w-full p-3 border rounded text-sm ${errors.address ? 'border-red-500' : 'border-[#d8c6bb]'} focus:border-[#b1121a] outline-none`}\r\n                                        placeholder=\"Street, Building, Apartment\"\r\n                                    />\r\n                                    {errors.address && <p className=\"text-red-500 text-[10px] mt-1\">{errors.address}</p>}\r\n                                    {errors.city && <p className=\"text-red-500 text-[10px] mt-1\">{errors.city}</p>}\r\n                                </div>\r\n\r\n                                {user && (\r\n                                    <div className=\"md:col-span-2 mt-2\">\r\n                                        <label className=\"flex items-center gap-2 cursor-pointer group\">\r\n                                            <input\r\n                                                type=\"checkbox\"\r\n                                                className=\"accent-[#b1121a] w-4 h-4 cursor-pointer\"\r\n                                                onChange={(e) => {\r\n                                                    // This would ideally be state-controlled, but for MVP we can handle it at submit time\r\n                                                    // For now, let's just make it a visual placeholder or simple state\r\n                                                    // To implement properly we need a new state: const [saveAddress, setSaveAddress] = useState(false)\r\n                                                }}\r\n                                            />\r\n                                            <span className=\"text-xs font-bold text-[#3a2d23] group-hover:text-[#b1121a] transition-colors\">\r\n                                                Save as new address in my profile\r\n     