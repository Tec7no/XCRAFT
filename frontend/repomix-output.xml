                            </div>
                            <Button
                              variant="destructive"
                              size="icon"
                              onClick={() => {
                                const newLinks = settings.socialLinks!.filter((_, i) => i !== index);
                                updateSettings(prev => ({ ...prev, socialLinks: newLinks }));
                              }}
                            >
                              <Trash2 className="h-4 w-4" />
                            </Button>
                          </div>
                        ))
                      ) : (
                        <div className="text-sm text-destructive">Legacy settings format detected. Please reset theme.</div>
                      )}

                      <div className="border-t pt-4 mt-4">
                        <h4 className="text-sm font-bold mb-3 flex items-center gap-2"><Plus className="h-4 w-4" /> Add New Link</h4>
                        <div className="grid grid-cols-2 md:grid-cols-4 gap-2 items-end">
                          <div className="space-y-1 col-span-1">
