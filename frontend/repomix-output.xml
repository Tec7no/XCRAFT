                    <Separator className="bg-[#d8c6bb]/50" />

                    {/* Sizes */}
                    <div className="space-y-3">
                        <Label className="text-sm font-bold text-[#3a2d23] uppercase">{t("filters_size")}</Label>
                        <div className="flex flex-wrap gap-2">
                            {availableSizes.map((size) => {
                                const isSelected = filters.sizes.includes(size);
                                return (
                                    <button
                                        key={size}
                                        onClick={() => handleSizeToggle(size)}
                                        className={cn(
                                            "h-8 min-w-[2rem] px-2 rounded border text-xs font-bold transition-all",
                                            isSelected
                                                ? "border-[#b1121a] bg-[#b1121a] text-white"
