<file path="src/components/MarketingBanner.tsx">
import React from 'react';
import { useSiteSettings } from '@/config/SiteSettingsContext';
import { useLanguage } from '@/i18n/LanguageContext';
import { X } from 'lucide-react';

export default function MarketingBanner() {
    const { settings } = useSiteSettings();
    const { lang } = useLanguage();
    const [isVisible, setIsVisible] = React.useState(true);

    if (!settings.marketing?.enableTopBanner || !isVisible) return null;

    const text = settings.translations[lang]?.[settings.marketing.topBannerTextKey] || "Welcome!";

    return (
        <div className="bg-foreground text-background text-[10px] font-bold uppercase tracking-widest py-2 px-4 text-center relative animate-in slide-in-from-top duration-500">
            <span>{text}</span>
            <button
                onClick={() => setIsVisible(false)}
                className="absolute right-2 top-1/2 -translate-y-1/2 opacity-50 hover:opacity-100 p-1"
            >
                <X size={12} />
            </button>
        </div>
    );
}
</file>

<file path="src/components/NavLink.tsx">
import { NavLink as RouterNavLink, NavLinkProps } from "react-router-dom";
import { forwardRef } from "react";
import { cn } from "@/lib/utils";

interface NavLinkCompatProps extends Omit<NavLinkProps, "className"> {
  className?: string;
  activeClassName?: string;
  pendingClassName?: string;
}

const NavLink = forwardRef<HTMLAnchorElement, NavLinkCompatProps>(
  ({ className, activeClassName, pendingClassName, to, ...props }, ref) => {
    return (
      <RouterNavLink
        ref={ref}
        to={to}
        className={({ isActive, isPending }) =>
          cn(className, isActive && activeClassName, isPending && pendingClassName)
        }
        {...props}
      />
    );
  },
);

NavLink.displayName = "NavLink";

export { NavLink };
</file>

<file path="src/components/NewsletterPopup.tsx">
import React, { useState, useEffect } from 'react';
import { X, Mail, ArrowRight, Gift } from 'lucide-react';
import { Button } from '@/components/ui/button';
import { useToast } from '@/hooks/use-toast';
import { useLanguage } from '@/i18n/LanguageContext';

const NewsletterPopup = () => {
    const [isOpen, setIsOpen] = useState(false);
    const [email, setEmail] = useState('');
    const { toast } = useToast();
    const { t } = useLanguage();

    useEffect(() => {
        // Check if already seen in this session
        const hasSeen = sessionStorage.getItem('newsletter_seen');
        if (!hasSeen) {
            // Show after 5 seconds
            const timer = setTimeout(() => {
                setIsOpen(true);
                sessionStorage.setItem('newsletter_seen', 'true');
            }, 5000);
            return () => clearTimeout(timer);
        }
    }, []);

    const handleSubscribe = (e: React.FormEvent) => {
        e.preventDefault();
        if (!email) return;

        // In a real app, send to backend
        console.log("Subscribed:", email);

        toast({
            title: t('newsletter_success_title'),
            description: t('newsletter_success_desc'),
        });
        setIsOpen(false);
    };

    if (!isOpen) return null;

    return (
        <div className="fixed inset-0 z-[200] flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-in fade-in duration-300">
            <div className="relative w-full max-w-md bg-background border-2 border-[var(--ic-primary)] rounded-2xl shadow-2xl p-8 overflow-hidden animate-in zoom-in-95 duration-300">
                {/* Decorative background element */}
                <div className="absolute top-0 right-0 w-32 h-32 bg-[var(--ic-primary)]/10 rounded-bl-[100px] -z-10" />

                <button
                    onClick={() => setIsOpen(false)}
                    className="absolute top-4 right-4 p-2 hover:bg-muted rounded-full transition-colors"
                >
                    <X size={20} className="text-muted-foreground" />
                </button>

                <div className="text-center space-y-4">
                    <div className="w-16 h-16 bg-[var(--ic-primary)]/10 rounded-full flex items-center justify-center mx-auto text-[var(--ic-primary)]">
                        <Gift size={32} />
                    </div>

                    <div className="space-y-2">
                        <h3 className="text-2xl font-black uppercase tracking-tight text-primary">{t('newsletter_title')}</h3>
                        <p className="text-sm text-muted-foreground font-medium leading-relaxed">
                            {t('newsletter_desc')}
                        </p>
                    </div>

                    <form onSubmit={handleSubscribe} className="space-y-3 pt-2">
                        <div className="relative">
                            <Mail className="absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground" size={16} />
                            <input
                                type="email"
                                placeholder={t('newsletter_email_placeholder')}
                                value={email}
                                onChange={(e) => setEmail(e.target.value)}
                                className="w-full pl-10 pr-4 py-3 bg-muted border border-border rounded-xl text-xs font-bold uppercase outline-none focus:border-[var(--ic-primary)] transition-colors"
                                required
                            />
                        </div>
                        <Button type="submit" className="w-full bg-[var(--ic-primary)] hover:bg-[var(--ic-primary-hover)] text-white font-black uppercase tracking-widest py-6 rounded-xl shadow-lg">
                            {t('newsletter_btn')} <ArrowRight size={16} className="ml-2" />
                        </Button>
                    </form>

                    <p className="text-[9px] text-muted-foreground uppercase tracking-widest">
                        {t('newsletter_privacy')}
                    </p>
                </div>
            </div>
        </div>
    );
};

export default NewsletterPopup;
</file>

<file path="src/components/OrderDetailsPanel.tsx">
/**
 * OrderDetailsPanel - Admin view for order details
 * Shows customer info, items, payment info, and status workflow buttons
 */

import * as React from 'react';
import { Order, OrderStatus } from '@/types';
import {
    User, Phone, Mail, MapPin, CreditCard, Truck, Building2,
    CheckCircle, XCircle, Package, Clock, AlertCircle, Trash2, Archive, RefreshCw
} from 'lucide-react';
import { updateOrderStatus } from '@/utils/ordersStore';
import { Button } from './ui/button';
import { Badge } from './ui/badge';

interface OrderDetailsPanelProps {
    order: Order;
    onUpdate: (order: Order) => void;
    onDelete?: () => void;
    onArchive?: () => void;
    onClose: () => void;
}

const STATUS_CONFIG: Record<string, { label: string; color: string; icon: React.ElementType }> = {
    pending_review: { label: 'Pending Review', color: 'bg-yellow-100 text-yellow-700 border-yellow-200', icon: Clock },
    accepted: { label: 'Accepted', color: 'bg-blue-100 text-blue-700 border-blue-200', icon: CheckCircle },
    rejected: { label: 'Rejected', color: 'bg-red-100 text-red-700 border-red-200', icon: XCircle },
    preparing: { label: 'Preparing', color: 'bg-purple-100 text-purple-700 border-purple-200', icon: Package },
    shipping: { label: 'Shipping', color: 'bg-orange-100 text-orange-700 border-orange-200', icon: Truck },
    delivered: { label: 'Delivered', color: 'bg-green-100 text-green-700 border-green-200', icon: CheckCircle },
};

const PAYMENT_LABELS: Record<string, string> = {
    cod: 'Cash on Delivery',
    transfer: 'Bank Transfer / Instapay',
    card: 'Credit/Debit Card',
};

export default function OrderDetailsPanel({ order, onUpdate, onDelete, onArchive, onClose }: OrderDetailsPanelProps) {
    const [rejectionReason, setRejectionReason] = React.useState('');
    const [showRejectDialog, setShowRejectDialog] = React.useState(false);
    const [showProofModal, setShowProofModal] = React.useState(false);

    const statusConfig = STATUS_CONFIG[order.status] || { label: order.status || 'Unknown', color: 'bg-gray-100 text-gray-700 border-gray-200', icon: AlertCircle };
    const StatusIcon = statusConfig.icon;

    const handleStatusChange = (newStatus: OrderStatus, reason?: string) => {
        const updated = updateOrderStatus(order.id, newStatus, reason);
        if (updated) {
            onUpdate(updated);
        }
    };

    const handleReject = () => {
        handleStatusChange('rejected', rejectionReason);
        setShowRejectDialog(false);
        setRejectionReason('');
    };

    return (
        <div className="bg-card border border-border rounded-lg shadow-sm h-full flex flex-col overflow-hidden animate-in fade-in slide-in-from-right-4 duration-300">
            {/* Header */}
            <div className="p-4 border-b border-border bg-muted/50 flex justify-between items-center">
                <div className="flex items-center gap-4">
                    <div>
                        <div className="flex items-center gap-2 mb-0.5">
                            <h3 className="text-sm font-black uppercase tracking-widest text-primary">#{order.id.split('-')[1]}</h3>
                            <Badge variant="outline" className={`text-[8px] font-black uppercase px-2 py-0 border ${statusConfig.color}`}>
                                {statusConfig.label}
                            </Badge>
                        </div>
                        <p className="text-[10px] font-bold text-muted-foreground">
                            {new Date(order.createdAt).toLocaleString()}
                        </p>
                    </div>
                </div>

                <div className="flex items-center gap-1.5">
                    {onArchive && (
                        <Button
                            variant="ghost"
                            size="icon"
                            className="h-8 w-8 text-muted-foreground hover:text-primary hover:bg-primary/5"
                            onClick={onArchive}
                            title={order.archived ? "Restore Order" : "Archive Order"}
                        >
                            {order.archived ? <RefreshCw size={14} /> : <Archive size={14} />}
                        </Button>
                    )}
                    {onDelete && (
                        <Button
                            variant="ghost"
                            size="icon"
                            className="h-8 w-8 text-muted-foreground hover:text-destructive hover:bg-destructive/5"
                            onClick={onDelete}
                            title="Delete Order"
                        >
                            <Trash2 size={14} />
                        </Button>
                    )}
                    <div className="w-px h-4 bg-border mx-1" />
                    <Button
                        variant="ghost"
                        size="icon"
                        className="h-8 w-8 text-muted-foreground hover:text-primary hover:bg-primary/5"
                        onClick={onClose}
                    >
                        ✕
                    </Button>
                </div>
            </div>

            {/* Scrollable Content */}
            <div className="flex-1 overflow-y-auto p-6 space-y-6">
                <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                    {/* Customer Info */}
                    <div className="space-y-4">
                        <section>
                            <h4 className="text-[10px] font-black uppercase text-muted-foreground tracking-widest mb-3 flex items-center gap-2">
                                <User size={12} /> Customer Information
                            </h4>
                            <div className="bg-muted/30 p-4 rounded-xl border border-border/50 space-y-3">
                                <div className="flex items-center gap-3">
                                    <div className="w-8 h-8 rounded-full bg-secondary/10 flex items-center justify-center text-secondary font-black text-xs">
                                        {(order.customer?.fullName || 'L').charAt(0)}
                                    </div>
                                    <span className="font-black text-sm text-primary">{order.customer?.fullName || 'Legacy Customer'}</span>
                                </div>
                                <div className="grid gap-2 text-[11px] font-bold text-muted-foreground">
                                    <div className="flex items-center gap-2">
                                        <Phone size={12} />
                                        <span>{order.customer?.phone || 'No phone'}</span>
                                    </div>
                                    {order.customer?.email && (
                                        <div className="flex items-center gap-2">
                                            <Mail size={12} />
                                            <span>{order.customer.email}</span>
                                        </div>
                                    )}
                                    <div className="flex items-start gap-2">
                                        <MapPin size={12} className="mt-0.5" />
                                        <span className="leading-tight">{order.customer?.address || 'No address'}, {order.customer?.city || ''}</span>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section>
                            <h4 className="text-[10px] font-black uppercase text-muted-foreground tracking-widest mb-3 flex items-center gap-2">
                                <CreditCard size={12} /> Payment Details
                            </h4>
                            <div className="bg-muted/30 p-4 rounded-xl border border-border/50">
                                <div className="flex items-center justify-between mb-3">
                                    <span className="text-[11px] font-bold text-primary">
                                        {order.payment?.method ? PAYMENT_LABELS[order.payment.method] : 'Standard Payment'}
                                    </span>
                                    {order.payment?.method === 'cod' && <Truck size={14} className="text-secondary" />}
                                    {order.payment?.method === 'transfer' && <Building2 size={14} className="text-secondary" />}
                                    {order.payment?.method === 'card' && <CreditCard size={14} className="text-secondary" />}
                                </div>

                                {order.payment?.proofImage && (
                                    <div className="relative group cursor-pointer" onClick={() => setShowProofModal(true)}>
                                        <img
                                            src={order.payment.proofImage}
                                            alt="Payment proof"
                                            className="w-full h-24 object-cover rounded-lg border border-border transition-all group-hover:brightness-90"
                                        />
                                        <div className="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                                            <Badge className="bg-primary/80 text-white backdrop-blur-sm">View Proof</Badge>
                                        </div>
                                    </div>
                                )}
                            </div>
                        </section>
                    </div>

                    {/* Order Items & Totals */}
                    <div className="space-y-4">
                        <section>
                            <h4 className="text-[10px] font-black uppercase text-muted-foreground tracking-widest mb-3 flex items-center gap-2">
                                <Package size={12} /> Order Summary
                            </h4>
                            <div className="bg-muted/30 rounded-xl border border-border/50 overflow-hidden">
                                <div className="max-h-[240px] overflow-y-auto divide-y divide-border/50">
                                    {order.items.map((item, idx) => (
                                        <div key={idx} className="p-3 flex gap-3 hover:bg-muted/50 transition-colors">
                                            {item.image && (
                                                <img src={item.image} alt={item.name} className="w-10 h-10 object-cover rounded bg-white shadow-sm" />
                                            )}
                                            <div className="flex-1 min-w-0">
                                                <p className="text-[11px] font-black uppercase text-primary truncate leading-tight">{item.name}</p>
                                                <div className="flex items-center gap-1.5 mt-0.5">
                                                    <span className="text-[9px] font-bold text-muted-foreground uppercase">{item.size}</span>
                                                    <span className="text-muted-foreground">/</span>
                                                    <div
                                                        className="w-2 h-2 rounded-full border border-border/50"
                                                        style={{ backgroundColor: item.color }}
                                                    />
                                                    <span className="text-[9px] font-bold text-muted-foreground uppercase">{item.colorName}</span>
                                                </div>
                                                <div className="flex justify-between items-end mt-1">
                                                    <span className="text-[9px] font-medium text-muted-foreground">
                                                        {item.quantity} × {item.unitPrice.toLocaleString()}
                                                    </span>
                                                    <span className="text-[11px] font-black text-secondary">
                                                        {item.lineTotal.toLocaleString()} EGP
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    ))}
                                </div>
                                <div className="p-4 bg-[#f6efea] border-t border-[#d8c6bb] space-y-1.5">
                                    <div className="flex justify-between text-[11px] font-bold text-muted-foreground">
                                        <span>Subtotal</span>
                                        <span>{order.subtotal.toLocaleString()} EGP</span>
                                    </div>
                                    {order.discount > 0 && (
                                        <div className="flex justify-between text-[11px] font-bold text-green-600">
                                            <span>Discount</span>
                                            <span>-{order.discount.toLocaleString()} EGP</span>
                                        </div>
                                    )}
                                    <div className="flex justify-between text-[11px] font-bold text-muted-foreground">
                                        <span>Delivery</span>
                                        <span>{order.delivery === 0 ? 'FREE' : `${order.delivery.toLocaleString()} EGP`}</span>
                                    </div>
                                    <div className="flex justify-between items-end pt-2 mt-1 border-t border-[#d8c6bb]/50">
                                        <span className="text-xs font-black uppercase tracking-widest text-primary">Total Amount</span>
                                        <span className="text-lg font-black text-[#b1121a] leading-none">{order.total.toLocaleString()} EGP</span>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </div>

                {/* Rejection Reason (if rejected) */}
                {order.status === 'rejected' && order.rejectionReason && (
                    <div className="bg-red-50 border border-red-100 p-4 rounded-xl animate-in fade-in zoom-in-95 duration-200">
                        <div className="flex items-center gap-2 text-red-600 mb-2">
                            <AlertCircle size={14} />
                            <span className="text-[10px] font-black uppercase tracking-widest">Rejection Reason</span>
                        </div>
                        <p className="text-sm font-medium text-red-800/80 leading-relaxed">{order.rejectionReason}</p>
                    </div>
                )}
            </div>

            {/* Status Actions */}
            <div className="p-4 border-t border-border bg-muted/50">
                {!order.archived ? (
                    <div className="max-w-md mx-auto">
                        {order.status === 'pending_review' && (
                            <div className="grid grid-cols-2 gap-3">
                                <Button
                                    onClick={() => handleStatusChange('accepted')}
                                    className="bg-green-600 hover:bg-green-700 text-white font-black uppercase tracking-widest text-[10px] h-11"
                                >
                                    <CheckCircle size={16} className="mr-2" /> Accept Order
                                </Button>
                                <Button
                                    variant="destructive"
                                    onClick={() => setShowRejectDialog(true)}
                                    className="font-black uppercase tracking-widest text-[10px] h-11"
                                >
                                    <XCircle size={16} className="mr-2" /> Reject
                                </Button>
                            </div>
                        )}

                        {order.status === 'accepted' && (
                            <Button
                                onClick={() => handleStatusChange('preparing')}
                                className="w-full bg-purple-600 hover:bg-purple-700 text-white font-black uppercase tracking-widest text-[10px] h-11"
                            >
                                <Package size={16} className="mr-2" /> Start Preparation
                            </Button>
                        )}

                        {order.status === 'preparing' && (
                            <Button
                                onClick={() => handleStatusChange('shipping')}
                                className="w-full bg-orange-500 hover:bg-orange-600 text-white font-black uppercase tracking-widest text-[10px] h-11"
                            >
                                <Truck size={16} className="mr-2" /> Out for Delivery
                            </Button>
                        )}

                        {order.status === 'shipping' && (
                            <Button
                                onClick={() => handleStatusChange('delivered')}
                                className="w-full bg-green-600 hover:bg-green-700 text-white font-black uppercase tracking-widest text-[10px] h-11"
                            >
                                <CheckCircle size={16} className="mr-2" /> Confirm Delivery
                            </Button>
                        )}

                        {(order.status === 'delivered' || order.status === 'rejected') && (
                            <div className="text-center py-2">
                                <div className={`inline-flex items-center gap-2 px-6 py-2 rounded-full border-2 ${order.status === 'delivered' ? 'bg-green-50 border-green-200 text-green-700' : 'bg-red-50 border-red-200 text-red-700'}`}>
                                    {order.status === 'delivered' ? <CheckCircle size={18} /> : <XCircle size={18} />}
                                    <span className="text-xs font-black uppercase tracking-widest">
                                        Order {order.status}
                                    </span>
                                </div>
                            </div>
                        )}
                    </div>
                ) : (
                    <div className="text-center py-3 bg-primary/5 rounded-lg border border-primary/10">
                        <p className="text-[10px] font-black uppercase tracking-widest text-primary/60">
                            Order is archived and locked for editing.
                        </p>
                    </div>
                )}
            </div>

            {/* Reject Dialog */}
            {showRejectDialog && (
                <div className="fixed inset-0 z-[500] flex items-center justify-center bg-black/40 backdrop-blur-sm p-4 animate-in fade-in duration-200">
                    <div className="bg-white rounded-2xl p-6 max-w-sm w-full shadow-2xl border border-border animate-in zoom-in-95 duration-200">
                        <h4 className="text-lg font-black uppercase tracking-tighter text-primary mb-2">Reject Order</h4>
                        <p className="text-xs font-medium text-muted-foreground mb-4">Please provide a reason for rejecting this order to inform the customer.</p>
                        <textarea
                            value={rejectionReason}
                            onChange={e => setRejectionReason(e.target.value)}
                            placeholder="e.g. Out of stock, Location not covered..."
                            className="w-full border border-border rounded-xl p-4 text-sm font-bold mb-4 resize-none bg-muted/30 focus:bg-white focus:ring-2 focus:ring-secondary/20 outline-none transition-all"
                            rows={3}
                        />
                        <div className="flex gap-3">
                            <Button
                                variant="outline"
                                onClick={() => setShowRejectDialog(false)}
                                className="flex-1 font-bold h-11 rounded-xl"
                            >
                                Cancel
                            </Button>
                            <Button
                                variant="destructive"
                                onClick={handleReject}
                                className="flex-1 font-black uppercase tracking-widest text-[10px] h-11 rounded-xl"
                            >
                                Confirm Reject
                            </Button>
                        </div>
                    </div>
                </div>
            )}

            {/* Payment Proof Modal */}
            {showProofModal && order.payment.proofImage && (
                <div
                    className="fixed inset-0 z-[500] flex items-center justify-center bg-black/90 backdrop-blur-lg p-4 animate-in fade-in duration-300"
                    onClick={() => setShowProofModal(false)}
                >
                    <div className="relative group">
                        <img
                            src={order.payment.proofImage}
                            alt="Payment proof"
                            className="max-w-full max-h-[85vh] object-contain rounded-2xl shadow-2xl border border-white/10"
                        />
                        <Button
                            className="absolute -top-4 -right-4 bg-white text-black hover:bg-gray-200 rounded-full h-10 w-10 p-0 shadow-xl"
                        >
                            ✕
                        </Button>
                    </div>
                </div>
            )}
        </div>
    );
}
</file>

<file path="src/components/OrderTracking.tsx">
import * as React from 'react';
import { Check, Clock, Package, Truck, AlertCircle } from 'lucide-react';
import { OrderStatus } from '@/types';

interface OrderTrackingProps {
    status: OrderStatus | string;
    rejectionReason?: string;
}

const STEPS = [
    { id: 'placed', label: 'Order Placed', icon: Clock, statuses: ['pending_review'] },
    { id: 'processing', label: 'Processing', icon: Package, statuses: ['accepted', 'preparing'] },
    { id: 'shipping', label: 'Out for Delivery', icon: Truck, statuses: ['shipping'] },
    { id: 'delivered', label: 'Delivered', icon: Check, statuses: ['delivered'] },
];

const OrderTracking: React.FC<OrderTrackingProps> = ({ status, rejectionReason }) => {
    // Determine current step index
    // pending_review -> 0 (active)
    // accepted/preparing -> 1 (active), 0 (completed)
    // shipping -> 2 (active), 0,1 (completed)
    // delivered -> 3 (completed), 0,1,2 (completed)

    let currentStepIndex = 0;
    if (['accepted', 'preparing'].includes(status)) currentStepIndex = 1;
    else if (status === 'shipping') currentStepIndex = 2;
    else if (status === 'delivered') currentStepIndex = 4; // All completed
    else if (status === 'rejected') currentStepIndex = -1; // Special case

    if (currentStepIndex === -1) {
        return (
            <div className="bg-red-50 border border-red-200 rounded-lg p-4 flex items-start gap-3">
                <AlertCircle className="text-red-600 mt-0.5" size={18} />
                <div>
                    <p className="font-bold text-red-700 text-sm uppercase tracking-wide">Order Rejected</p>
                    <p className="text-red-600/80 text-xs mt-1">{rejectionReason || "We couldn't fulfill this order. Please contact support."}</p>
                </div>
            </div>
        );
    }

    return (
        <div className="py-6">
            <div className="relative flex justify-between">
                {/* Connecting Line */}
                <div className="absolute top-4 left-0 w-full h-0.5 bg-border -z-0">
                    <div
                        className="h-full bg-secondary transition-all duration-500"
                        style={{ width: `${Math.min(100, (currentStepIndex / (STEPS.length - 1)) * 100)}%` }}
                    />
                </div>

                {STEPS.map((step, index) => {
                    const isCompleted = index < currentStepIndex || currentStepIndex === 4; // 4 means delivered fully done
                    const isActive = !isCompleted && (
                        (index === currentStepIndex) ||
                        (index === 0 && status === 'pending_review')
                    );

                    const Icon = step.icon;

                    return (
                        <div key={step.id} className="relative z-10 flex flex-col items-center">
                            <div
                                className={`w-8 h-8 rounded-full flex items-center justify-center border-2 transition-all duration-300 ${isCompleted ? 'bg-secondary border-secondary text-secondary-foreground' :
                                        isActive ? 'bg-background border-secondary text-secondary shadow-[0_0_0_4px_rgba(var(--secondary-rgb),0.1)]' :
                                            'bg-muted border-border text-muted-foreground'
                                    }`}
                            >
                                {isCompleted ? <Check size={14} /> : <Icon size={14} />}
                            </div>
                            <span className={`text-[10px] font-bold uppercase tracking-widest mt-3 transition-colors ${isCompleted || isActive ? 'text-foreground' : 'text-muted-foreground'
                                }`}>
                                {step.label}
                            </span>
                        </div>
                    );
                })}
            </div>
        </div>
    );
};

export default OrderTracking;
</file>

