        <ShoppingCart size={22} />
        <span className="text-[10px] font-medium">Cart</span>
        {cartCount > 0 && (
          <span className="absolute top-0 right-4 bg-black text-white text-[9px] font-black w-4 h-4 flex items-center justify-center rounded-full border border-background">
            {cartCount}
          </span>
        )}
      </button>
    </nav>
  );
};

export default BottomNav;
