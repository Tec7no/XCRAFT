    const [user, setUser] = useStorageState<User | null>('user', null);
    const [cart] = useStorageState<CartItem[]>('cart', []);
    const [orders] = useStorageState<Order[]>('orders', []);
    const [wishlist] = useStorageState<string[]>('wishlist', []);

    // Address State
    const [isAddingAddress, setIsAddingAddress] = React.useState(false);
    const [newAddress, setNewAddress] = React.useState<Partial<Address>>({});

    if (!user) {
        navigate('/');
        return null;
    }

    const handleLogout = () => {
        setUser(null);
        navigate('/');
    };

    const handleSaveAddress = (e: React.FormEvent) => {
        e.preventDefault();
        if (!newAddress.fullName || !newAddress.address || !newAddress.city || !newAddress.phone || !newAddress.name) {
            toast({ title: "Validation Error", description: "Please fill all fields", variant: "destructive" });
            return;
        }

        const address: Address = {
            id: crypto.randomUUID(),
            name: newAddress.name,
            fullName: newAddress.fullName,
            phone: newAddress.phone,
            address: newAddress.address,
            city: newAddress.city,
            isDefault: user.addresses?.length === 0 // Make default if first
        };

        const updatedUser = {
            ...user,
            addresses: [...(user.addresses || []), address]
        };
        setUser(updatedUser);
        setIsAddingAddress(false);
        setNewAddress({});
        toast({ title: "Address Saved", description: "Your address book has been updated." });
    };

    const handleDeleteAddress = (id: string) => {
        if (!user.addresses) return;
        const updatedUser = {
            ...user,
            addresses: user.addresses.filter(a => a.id !== id)
        };
        setUser(updatedUser);
    };

    const handleSetDefault = (id: string) => {
        if (!user.addresses) return;
        const updatedUser = {
            ...user,
            addresses: user.addresses.map(a => ({ ...a, isDefault: a.id === id }))
        };
        setUser(updatedUser);
        toast({ title: "Default Updated", description: "Primary shipping address changed." });
