                          if (!link.href.startsWith('/')) {
                            // External or anchor
                          } else {
                            // If it's a shop link, we might want to handle it?
                            // For now, standard link behavior is fine or use Link from react-router-dom if available.
                            // But this project uses hrefs in Footer usually.
                          }
                        }}
