import React, { useState, useEffect } from 'react';
import { useNavigate } from 'react-router-dom';
import Header from '../components/Header';
import Footer from '../components/Footer';
import { ArrowRight, Sparkles, MoveRight } from 'lucide-react';
import { EditableSection } from '@/components/ui/editable-section';
import { EditableText } from '@/components/ui/editable-text';
import { motion } from 'framer-motion';

import { Button } from '@/components/ui/button';
import WebGLHero from '../components/WebGLHero';

// --- Hero Slide Data ---


// --- Bento Grid Data ---
import { useSiteSettings } from '@/config/SiteSettingsContext';

import { useLanguage } from '@/i18n/LanguageContext';

const GatewayPage = () => {
    const navigate = useNavigate();
    const { settings } = useSiteSettings();
    const { t } = useLanguage();
    const [userState, setUserState] = useState<any>(null);

    useEffect(() => {
        const stored = localStorage.getItem('user');
        if (stored) {
            try { setUserState(JSON.parse(stored)); } catch (e) { }
        }
    }, []);

    // Placeholder functions for Header props
    const handleSearch = (query) => {
        console.log("Search query:", query);
        navigate(`/shop?search=${query}`);
    };

    const handleNavigate = (category) => {
        navigate(`/shop/${category || ''}`);
    };

    const handleLogout = () => {
        localStorage.removeItem('user');
        setUserState(null);
        navigate('/');
        window.location.reload(); // Force refresh to clear state completely
    };

    // Use settings or fallback to empty array if not yet loaded
    const categories = settings.gatewayCategories || [];

    return (
        <div className="min-h-screen bg-background font-sans">
            <Header
                onSearchChange={handleSearch}
                onNavigate={handleNavigate}
                onAccount={() => navigate('/auth')}
                onLogout={handleLogout}
