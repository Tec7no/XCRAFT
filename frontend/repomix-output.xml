    onQuickView: (product: Product) => void;
    onToggleWishlist: (product: Product) => void;
}

const WishlistView: React.FC<WishlistViewProps> = ({
    wishlist,
    products,
    onSetView,
    onProductClick,
    onAddToCart,
    onQuickView,
