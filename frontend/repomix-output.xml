                                    className="h-6 w-6 p-0 text-gray-400 hover:text-white hover:bg-white/10"
                                >
                                    <ChevronUp className="h-3 w-3" />
                                </Button>
                                <Button
                                    variant="ghost"
                                    size="sm"
                                    onClick={() => moveItem(index, "down")}
                                    disabled={index === navItems.length - 1}
                                    className="h-6 w-6 p-0 text-gray-400 hover:text-white hover:bg-white/10"
                                >
                                    <ChevronDown className="h-3 w-3" />
                                </Button>
                                <Button
                                    variant="ghost"
