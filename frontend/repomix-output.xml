                <div className="flex items-center justify-between mb-6">
                    <h3 className="text-lg font-bold text-[#b1121a] uppercase tracking-widest">{t("filters_title")}</h3>
                    <Button
                        variant="ghost"
                        size="icon"
                        onClick={() => setOpen(false)}
                        className="h-8 w-8 text-[#3a2d23]/50 hover:text-[#b1121a]"
