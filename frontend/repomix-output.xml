                                            "h-6 w-6 rounded-full border shadow-sm transition-all",
                                            isSelected ? "ring-2 ring-[#b1121a] ring-offset-2 ring-offset-[#f6efea]" : "border-[#d8c6bb] hover:scale-110"
                                        )}
                                        style={{ backgroundColor: color.toLowerCase() }}
                                        title={color}
                                    />
