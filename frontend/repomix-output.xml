<file path="src/components/UserOrders.tsx">
import * as React from 'react';
import { Order, User } from '../types'; // Adjust path as needed
import { EditableText } from './ui/editable-text';
import { Package, ChevronDown, ChevronUp, Clock, CheckCircle, XCircle } from 'lucide-react';
import OrderTracking from './OrderTracking';

interface UserOrdersProps {
    orders: Order[];
    user: User;
    onBack: () => void;
}

const UserOrders: React.FC<UserOrdersProps> = ({ orders, user, onBack }) => {
    const [expandedOrderId, setExpandedOrderId] = React.useState<string | null>(null);

    // Filter orders for the current user (by email or phone)
    // Assuming user.email or user.phone matches customer info in order
    // For MVP, we might just show all if we rely on local storage "orders" being user-specific,
    // but usually orders storage is global in this simple app pattern.
    // Let's filter by email for safety if available, otherwise phone.
    const userOrders = React.useMemo(() => {
        return orders.filter(order =>
            (user.email && order.customer.email === user.email) ||
            (user.phone && (order.customer.phone === user.phone || order.id.includes(user.phone || '')))
        ).sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());
    }, [orders, user]);

    const toggleExpand = (orderId: string) => {
        setExpandedOrderId(prev => prev === orderId ? null : orderId);
    };

    const getStatusColor = (status: string) => {
        switch (status) {
            case 'delivered': return 'text-green-600 bg-green-50 border-green-200';
            case 'shipping': return 'text-blue-600 bg-blue-50 border-blue-200';
            case 'rejected': return 'text-red-600 bg-red-50 border-red-200';
            case 'pending_review': return 'text-yellow-600 bg-yellow-50 border-yellow-200';
            default: return 'text-muted-foreground bg-muted border-border';
        }
    };

    const getStatusIcon = (status: string) => {
        switch (status) {
            case 'delivered': return <CheckCircle size={14} />;
            case 'rejected': return <XCircle size={14} />;
            default: return <Clock size={14} />;
        }
    };

    return (
        <div className="bg-background min-h-[60vh] py-12 animate-fade-in-up">
            <div className="max-w-4xl mx-auto px-4 sm:px-6">
                <div className="mb-8 flex items-center gap-4">
                    <button onClick={onBack} className="text-sm font-bold uppercase tracking-widest text-muted-foreground hover:text-primary transition-colors">
                        &larr; Back
                    </button>
                    <h1 className="text-2xl font-black uppercase tracking-tighter text-foreground">
                        My Orders
                    </h1>
                </div>

                {userOrders.length === 0 ? (
                    <div className="text-center py-20 border border-dashed border-border rounded-lg bg-muted/30">
                        <Package className="mx-auto h-12 w-12 text-muted-foreground/50 mb-4" />
                        <h3 className="text-lg font-bold text-foreground mb-2">No orders found</h3>
                        <p className="text-muted-foreground text-sm">You haven't placed any orders yet.</p>
                        <button onClick={onBack} className="mt-6 text-secondary font-bold uppercase text-xs tracking-widest hover:underline">
                            Start Shopping
                        </button>
                    </div>
                ) : (
                    <div className="space-y-4">
                        {userOrders.map(order => {
                            const isExpanded = expandedOrderId === order.id;

                            return (
                                <div key={order.id} className="border border-border rounded-lg overflow-hidden bg-card transition-all hover:shadow-md">
                                    <div
                                        className="p-5 flex flex-col md:flex-row md:items-center gap-4 cursor-pointer select-none"
                                        onClick={() => toggleExpand(order.id)}
                                    >
                                        <div className="flex-1">
                                            <div className="flex items-center gap-3 mb-1">
                                                <span className="font-bold text-sm tracking-wide">#{order.id.slice(0, 8)}...</span>
                                                <span className={`text-[10px] font-bold uppercase px-2 py-0.5 rounded-full border flex items-center gap-1 ${getStatusColor(order.status)}`}>
                                                    {getStatusIcon(order.status)}
                                                    {order.status.replace('_', ' ')}
                                                </span>
                                            </div>
                                            <p className="text-xs text-muted-foreground">
                                                {new Date(order.createdAt).toLocaleDateString()} at {new Date(order.createdAt).toLocaleTimeString()}
                                            </p>
                                        </div>

                                        <div className="flex items-center justify-between md:gap-8">
                                            <div className="text-right">
                                                <p className="font-bold text-sm">EGP {order.total.toLocaleString()}</p>
                                                <p className="text-[10px] text-muted-foreground">{order.items.length} items</p>
                                            </div>
                                            {isExpanded ? <ChevronUp size={20} className="text-muted-foreground" /> : <ChevronDown size={20} className="text-muted-foreground" />}
                                        </div>
                                    </div>

                                    {isExpanded && (
                                        <div className="bg-muted/20 border-t border-border p-5 animate-fade-in text-sm">
                                            {/* Order Progress Tracker */}
                                            <div className="mb-8 px-4">
                                                <OrderTracking
                                                    status={order.status}
                                                    rejectionReason={order.rejectionReason}
                                                />
                                            </div>

                                            <div className="space-y-3">
                                                {order.items.map((item, idx) => (
                                                    <div key={idx} className="flex gap-4 items-center">
                                                        <div className="h-12 w-12 bg-muted rounded border border-border overflow-hidden flex-shrink-0">
                                                            {item.image && <img src={item.image} alt={item.name} className="w-full h-full object-cover" />}
                                                        </div>
                                                        <div className="flex-1">
                                                            <p className="font-bold text-foreground text-xs uppercase tracking-wide">{item.name}</p>
                                                            <p className="text-[10px] text-muted-foreground">
                                                                {item.size} / {item.colorName || item.color} • x{item.quantity}
                                                            </p>
                                                        </div>
                                                        <span className="font-medium text-xs">EGP {item.lineTotal.toLocaleString()}</span>
                                                    </div>
                                                ))}
                                            </div>

                                            <div className="mt-6 pt-4 border-t border-border flex flex-col gap-2 text-xs">
                                                <div className="flex justify-between">
                                                    <span className="text-muted-foreground">Subtotal</span>
                                                    <span>EGP {order.subtotal.toLocaleString()}</span>
                                                </div>
                                                <div className="flex justify-between">
                                                    <span className="text-muted-foreground">Delivery</span>
                                                    <span>EGP {order.delivery.toLocaleString()}</span>
                                                </div>
                                                <div className="flex justify-between font-bold text-base border-t border-border pt-2 mt-2">
                                                    <span>Total</span>
                                                    <span>EGP {order.total.toLocaleString()}</span>
                                                </div>
                                            </div>

                                            <div className="mt-4 bg-muted p-3 rounded text-xs text-muted-foreground">
                                                <p className="font-bold mb-1 uppercase tracking-widest text-[10px]">Delivery Details</p>
                                                <p>{order.customer.fullName}</p>
                                                <p>{order.customer.phone}</p>
                                                <p>{order.customer.address}, {order.customer.city}</p>
                                            </div>
                                        </div>
                                    )}
                                </div>
                            );
                        })}
                    </div>
                )}
            </div>
        </div>
    );
};

export default UserOrders;
</file>

<file path="src/components/WebGLHero.tsx">
import React, { useEffect, useRef, useState } from 'react';
import * as THREE from 'three';
import gsap from 'gsap';
import { useLanguage } from '@/i18n/LanguageContext';
import { useSiteSettings } from '@/config/SiteSettingsContext';

const SLIDER_CONFIG = {
    settings: {
        transitionDuration: 2.5,
        autoSlideSpeed: 5000,
        currentEffect: "glass",
        speedMultiplier: 1.0,
        distortionStrength: 1.0,
        globalIntensity: 1.0,
        // Glass preset
        glassRefractionStrength: 1.0,
        glassChromaticAberration: 1.0,
        glassBubbleClarity: 1.0,
        glassEdgeGlow: 1.0,
        glassLiquidFlow: 1.0,
    }
};

const fragmentShader = `
uniform sampler2D uTexture1, uTexture2;
uniform float uProgress;
uniform vec2 uResolution, uTexture1Size, uTexture2Size;
uniform float uGlobalIntensity, uSpeedMultiplier, uDistortionStrength;
uniform float uGlassRefractionStrength, uGlassChromaticAberration, uGlassBubbleClarity, uGlassEdgeGlow, uGlassLiquidFlow;
varying vec2 vUv;

vec2 getCoverUV(vec2 uv, vec2 textureSize) {
    vec2 s = uResolution / textureSize;
    float scale = max(s.x, s.y);
    vec2 scaledSize = textureSize * scale;
    vec2 offset = (uResolution - scaledSize) * 0.5;
    return (uv * uResolution - offset) / scaledSize;
}

vec4 glassEffect(vec2 uv, float progress) {
    float time = progress * 5.0 * uSpeedMultiplier;
    vec2 uv1 = getCoverUV(uv, uTexture1Size); 
    vec2 uv2 = getCoverUV(uv, uTexture2Size);
    
    float maxR = length(uResolution) * 0.85; 
    float br = progress * maxR;
    vec2 p = uv * uResolution; 
    vec2 c = uResolution * 0.5;
    float d = length(p - c); 
    float nd = d / max(br, 0.001);
    float param = smoothstep(br + 3.0, br - 3.0, d); // Inside circle

    vec4 img;
    if (param > 0.0) {
            float ro = 0.08 * uGlassRefractionStrength * uDistortionStrength * uGlobalIntensity * pow(smoothstep(0.3 * uGlassBubbleClarity, 1.0, nd), 1.5);
            vec2 dir = (d > 0.0) ? (p - c) / d : vec2(0.0);
            vec2 distUV = uv2 - dir * ro;
            distUV += vec2(sin(time + nd * 10.0), cos(time * 0.8 + nd * 8.0)) * 0.015 * uGlassLiquidFlow * uSpeedMultiplier * nd * param;
            float ca = 0.02 * uGlassChromaticAberration * uGlobalIntensity * pow(smoothstep(0.3, 1.0, nd), 1.2);
            img = vec4(texture2D(uTexture2, distUV + dir * ca * 1.2).r, texture2D(uTexture2, distUV + dir * ca * 0.2).g, texture2D(uTexture2, distUV - dir * ca * 0.8).b, 1.0);
            if (uGlassEdgeGlow > 0.0) {
            float rim = smoothstep(0.95, 1.0, nd) * (1.0 - smoothstep(1.0, 1.01, nd));
            img.rgb += rim * 0.08 * uGlassEdgeGlow * uGlobalIntensity;
            }
    } else { 
        img = texture2D(uTexture2, uv2); 
    }
    vec4 oldImg = texture2D(uTexture1, uv1);
    if (progress > 0.95) img = mix(img, texture2D(uTexture2, uv2), (progress - 0.95) / 0.05);
    return mix(oldImg, img, param);
}

void main() {
    gl_FragColor = glassEffect(vUv, uProgress);
}
`;

const vertexShader = `
varying vec2 vUv; 
void main() { 
    vUv = uv; 
    gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0); 
}`;

interface Slide {
    title: string;
    description: string;
    media: string;
}

interface WebGLHeroProps {
    onNavigate?: (category: string | null) => void;
}

const WebGLHero: React.FC<WebGLHeroProps> = ({ onNavigate }) => {
    const containerRef = useRef<HTMLDivElement>(null);
    const canvasRef = useRef<HTMLCanvasElement>(null);
    const { t } = useLanguage();
    const { settings } = useSiteSettings();

    // State for content
    const [currentSlideIndex, setCurrentSlideIndex] = useState(0);
    const [isLoaded, setIsLoaded] = useState(false);

    // Refs for Three.js objects to persist across renders without causing re-renders
    const sceneRef = useRef<THREE.Scene | null>(null);
    const cameraRef = useRef<THREE.OrthographicCamera | null>(null);
    const rendererRef = useRef<THREE.WebGLRenderer | null>(null);
    const materialRef = useRef<THREE.ShaderMaterial | null>(null);
    const texturesRef = useRef<THREE.Texture[]>([]);
    const animationFrameRef = useRef<number | null>(null);
    const isTransitioningRef = useRef(false);

    // Default slides (fallback)
    const defaultSlides: Slide[] = [
        {
            title: "SPLASH WOMAN",
            description: "Dive into the new summer collection.",
            media: "https://images.unsplash.com/photo-1469334031218-e382a71b716b?w=1920&q=80"
        },
        {
            title: "GOLDEN HOUR",
            description: "Radiate elegance in every moment.",
            media: "https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?w=1920&q=80"
        },
        {
            title: "ETHEREAL GLOW",
            description: "Timeless fashion for the modern soul.",
            media: "https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=1920&q=80"
        },
    ];

    // Use slides from settings or fallback to defaults
    const slides: Slide[] = settings.heroSlides && settings.heroSlides.length > 0
        ? settings.heroSlides
        : defaultSlides;

    // Initialize Three.js
    useEffect(() => {
        if (!canvasRef.current) return;

        // SCENE SETUP
        const scene = new THREE.Scene();
        sceneRef.current = scene;

        const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);
        cameraRef.current = camera;

        const renderer = new THREE.WebGLRenderer({
            canvas: canvasRef.current,
            antialias: false,
            alpha: false
        });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        rendererRef.current = renderer;

        const geometry = new THREE.PlaneGeometry(2, 2);

        // MATERIAL SETUP
        const material = new THREE.ShaderMaterial({
            uniforms: {
                uTexture1: { value: null },
                uTexture2: { value: null },
                uProgress: { value: 0 },
                uResolution: { value: new THREE.Vector2(window.innerWidth, window.innerHeight) },
                uTexture1Size: { value: new THREE.Vector2(1, 1) },
                uTexture2Size: { value: new THREE.Vector2(1, 1) },
                uGlobalIntensity: { value: SLIDER_CONFIG.settings.globalIntensity },
                uSpeedMultiplier: { value: SLIDER_CONFIG.settings.speedMultiplier },
                uDistortionStrength: { value: SLIDER_CONFIG.settings.distortionStrength },
                uGlassRefractionStrength: { value: SLIDER_CONFIG.settings.glassRefractionStrength },
                uGlassChromaticAberration: { value: SLIDER_CONFIG.settings.glassChromaticAberration },
                uGlassBubbleClarity: { value: SLIDER_CONFIG.settings.glassBubbleClarity },
                uGlassEdgeGlow: { value: SLIDER_CONFIG.settings.glassEdgeGlow },
                uGlassLiquidFlow: { value: SLIDER_CONFIG.settings.glassLiquidFlow },
            },
            vertexShader,
            fragmentShader,
        });
        materialRef.current = material;

        const plane = new THREE.Mesh(geometry, material);
        scene.add(plane);

        // TEXTURE LOADING
        const textureLoader = new THREE.TextureLoader();
        let loadedCount = 0;

        const loadTexture = (url: string) => {
            return new Promise<THREE.Texture>((resolve) => {
                textureLoader.load(url, (texture) => {
                    texture.minFilter = THREE.LinearFilter;
                    texture.magFilter = THREE.LinearFilter;
                    texture.userData.size = new THREE.Vector2(texture.image.width, texture.image.height);
                    resolve(texture);
                });
            });
        };

        Promise.all(slides.map(s => loadTexture(s.media))).then(loadedTextures => {
            texturesRef.current = loadedTextures;
            if (loadedTextures.length >= 2) {
                material.uniforms.uTexture1.value = loadedTextures[0];
                material.uniforms.uTexture2.value = loadedTextures[1];
                material.uniforms.uTexture1Size.value = loadedTextures[0].userData.size;
                material.uniforms.uTexture2Size.value = loadedTextures[1].userData.size;
                setIsLoaded(true);
            }
        });

        // RENDER LOOP
        const animate = () => {
            animationFrameRef.current = requestAnimationFrame(animate);
            renderer.render(scene, camera);
        };
        animate();

        // RESIZE HANDLER
        const handleResize = () => {
            const width = window.innerWidth;
            const height = window.innerHeight;
            renderer.setSize(width, height);
            material.uniforms.uResolution.value.set(width, height);
        };
        window.addEventListener('resize', handleResize);

        return () => {
            window.removeEventListener('resize', handleResize);
            if (animationFrameRef.current) cancelAnimationFrame(animationFrameRef.current);
            renderer.dispose();
            geometry.dispose();
            // material.dispose(); // ShaderMaterial cleanup
        };
    }, []);

    // SLIDE TRANSITION LOGIC
    const navigateToSlide = (targetIndex: number) => {
        if (isTransitioningRef.current || targetIndex === currentSlideIndex) return;
        if (!materialRef.current || texturesRef.current.length === 0) return;

        isTransitioningRef.current = true;
        const currentTexture = texturesRef.current[currentSlideIndex];
        const targetTexture = texturesRef.current[targetIndex];

        materialRef.current.uniforms.uTexture1.value = currentTexture;
        materialRef.current.uniforms.uTexture2.value = targetTexture;
        materialRef.current.uniforms.uTexture1Size.value = currentTexture.userData.size;
        materialRef.current.uniforms.uTexture2Size.value = targetTexture.userData.size;

        // Animate Content Out
        const titleEl = document.getElementById('hero-title');
        const descEl = document.getElementById('hero-desc');

        if (titleEl) gsap.to(titleEl, { y: -30, opacity: 0, duration: 0.5, ease: "power2.in" });
        if (descEl) gsap.to(descEl, { y: -20, opacity: 0, duration: 0.4, ease: "power2.in" });

        // Animate Shader
        gsap.fromTo(materialRef.current.uniforms.uProgress,
            { value: 0 },
            {
                value: 1,
                duration: 2.5,
                ease: "power2.inOut",
                onComplete: () => {
                    if (materialRef.current) {
                        materialRef.current.uniforms.uProgress.value = 0;
                        materialRef.current.uniforms.uTexture1.value = targetTexture;
                        materialRef.current.uniforms.uTexture1Size.value = targetTexture.userData.size;
                    }
                    isTransitioningRef.current = false;
                    setCurrentSlideIndex(targetIndex);
                }
            }
        );

        // Animate Content In (Delayed)
        setTimeout(() => {
            setCurrentSlideIndex(targetIndex); // React State Update for text render
            // Logic continues in useEffect based on currentSlideIndex change
        }, 1000);
    };

    // Content Animation Effect
    useEffect(() => {
        const titleEl = document.getElementById('hero-title');
        const descEl = document.getElementById('hero-desc');

        if (titleEl && descEl && isLoaded) {
            // Reset positions
            gsap.set(titleEl, { y: 30, opacity: 0 });
            gsap.set(descEl, { y: 20, opacity: 0 });

            // Animate In
            gsap.to(titleEl, { y: 0, opacity: 1, duration: 1, ease: "power3.out", delay: 0.1 });
            gsap.to(descEl, { y: 0, opacity: 1, duration: 1, ease: "power3.out", delay: 0.3 });
        }
    }, [currentSlideIndex, isLoaded]);

    // Auto-play
    useEffect(() => {
        if (!isLoaded) return;
        const timer = setInterval(() => {
            if (!isTransitioningRef.current) {
                const next = (currentSlideIndex + 1) % slides.length;
                navigateToSlide(next);
            }
        }, 6000);
        return () => clearInterval(timer);
    }, [currentSlideIndex, isLoaded]);

    return (
        <div ref={containerRef} className="relative w-full h-[100vh] overflow-hidden bg-black">
            <canvas ref={canvasRef} className="absolute inset-0 w-full h-full z-0 block" />

            {/* Overlay Gradient for Text Readability - Matching Splash Theme */}
            <div className="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent pointer-events-none z-10" />

            {/* Content Container */}
