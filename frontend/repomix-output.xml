                         : 'border-[#d8c6bb] hover:border-[#b1121a]/50'\r\n                                    }`}\r\n                            >\r\n                                <Truck className={`w-6 h-6 ${paymentMethod === 'cod' ? 'text-[#b1121a]' : 'text-[#3a2d23]/60'}`} />\r\n                                <div className=\"text-left\">\r\n                                    <p className=\"font-bold text-[#3a2d23]\">Cash on Delivery</p>\r\n                                    <p className=\"text-xs text-[#3a2d23]/60\">Pay when you receive your order</p>\r\n                                </div>\r\n                            </button>\r\n\r\n                            {/* Bank Transfer */}\r\n                            <button\r\n                                type=\"button\"\r\n                                onClick={() => setPaymentMethod('transfer')}\r\n                                className={`w-full p-4 border-2 rounded-lg flex items-center gap-4 transition-all ${paymentMethod === 'transfer'\r\n                                    ? 'border-[#b1121a] bg-[#b1121a]/5'\r\n                                    : 'border-[#d8c6bb] hover:border-[#b1121a]/50'\r\n                                    }`}\r\n                            >\r\n                                <Building2 className={`w-6 h-6 ${paymentMethod === 'transfer' ? 'text-[#b1121a]' : 'text-[#3a2d23]/60'}`} />\r\n                                <div className=\"text-left\">\r\n                                    <p className=\"font-bold text-[#3a2d23]\">Bank Transfer / Instapay / Vodafone Cash</p>\r\n                                    <p className=\"text-xs text-[#3a2d23]/60\">Upload payment screenshot after transfer</p>\r\n                                </div>\r\n                            </button>\r\n\r\n                            {/* Card */}\r\n                            <button\r\n                                type=\"button\"\r\n                                onClick={() => setPaymentMethod('card')}\r\n                                className={`w-full p-4 border-2 rounded-lg flex items-center gap-4 transition-all ${paymentMethod === 'card'\r\n                                    ? 'border-[#b1121a] bg-[#b1121a]/5'\r\n                                    : 'border-[#d8c6bb] hover:border-[#b1121a]/50'\r\n                                    }`}\r\n                            >\r\n                                <CreditCard className={`w-6 h-6 ${paymentMethod === 'card' ? 'text-[#b1121a]' : 'text-[#3a2d23]/60'}`} />\r\n                                <div className=\"text-left\">\r\n                                    <p className=\"font-bold text-[#3a2d23]\">Credit/Debit Card</p>\r\n                                    <p className=\"text-xs text-[#3a2d23]/60\">Secure online payment</p>\r\n                                </div>\r\n                            </button>\r\n\r\n                            {/* Card Form Injection */}\r\n                            {paymentMethod === 'card' && (\r\n                                <CreditCardForm\r\n                                    onChange={(details, isValid) => {\r\n                                        setCardDetails(details);\r\n                                        setIsCardValid(isValid);\r\n                                    }}\r\n                                    disabled={isSubmitting}\r\n                                />\r\n                            )}\r\n                        </div>\r\n\r\n                        {/* Payment Proof Upload (for transfer) */}\r\n                        {paymentMethod === 'transfer' && (\r\n                            <div className=\"mt-4 p-4 bg-[#f6efea] rounded-lg\">\r\n                                <p className=\"text-xs font-bold uppercase text-[#3a2d23]/60 mb-2\">Upload Payment Proof *</p>\r\n                                <p className=\"text-xs text-[#3a2d23]/60 mb-3\">\r\n                                    Transfer to: <span className=\"font-bold\">Instapay/VodafoneCash: 01xxxxxxxxx</span>\r\n                                </p>\r\n\r\n                                {proofImage ? (\r\n                                    <div className=\"relative\">\r\n                                        <img src={proofImage} alt=\"Payment proof\" className=\"w-full max-h-48 object-contain rounded border border-[#d8c6bb]\" />\r\n                                        <button\r\n                                            type=\"button\"\r\n                                            onClick={() => setProofImage('')}\r\n                                            className=\"absolute top-2 right-2 bg-red-500 text-white p-1 rounded-full text-xs\"\r\n                                        >\r\n                                            Γ£ò\r\n                                        </button>\r\n                                    </div>\r\n                                ) : (\r\n                                    <label className={`flex flex-col items-center justify-center p-6 border-2 border-dashed rounded-lg cursor-pointer transition-all ${errors.proof ? 'border-red-500 bg-red-50' : 'border-[#d8c6bb] hover:border-[#b1121a]'\r\n                                        }`}>\r\n                                        <Upload className=\"w-8 h-8 text-[#3a2d23]/40 mb-2\" />\r\n                                        <span className=\"text-sm text-[#3a2d23]/60\">Click to upload screenshot</span>\r\n                                        <input\r\n                                            type=\"file\"\r\n                                            accept=\"image/*\"\r\n                                            onChange={handleProofUpload}\r\n                                            className=\"hidden\"\r\n                                        />\r\n                                    </label>\r\n                                )}\r\n                                {errors.proof && <p className=\"text-red-500 text-[10px] mt-2\">{errors.proof}</p>}\r\n                            </div>\r\n                        )}\r\n                    </div>\r\n                </div>\r\n\r\n                {/* Right: Order Summary */}\r\n                <div className=\"lg:col-span-1\">\r\n                    <div className=\"bg-white p-6 rounded-lg shadow-sm border border-[#d8c6bb] sticky top-4\">\r\n                        <h3 className=\"text-sm font-black uppercase tracking-widest text-[#3a2d23] mb-4 border-b border-[#d8c6bb] pb-3\">\r\n                            Order Summary\r\n                        </h3>\r\n\r\n                        {/* Items */}\r\n                        <div className=\"space-y-3 max-h-64 overflow-y-auto mb-4\">\r\n                            {cart.map(item => (\r\n                                <div key={`${item.id}-${item.selectedColor}-${item.selectedSize}`} className=\"flex gap-3\">\r\n                                    <div className=\"w-14 h-16 bg-gray-100 rounded overflow-hidden flex-shrink-0\">\r\n                                        <img src={item.images[0]} alt={item.name} className=\"w-full h-full object-cover\" />\r\n                                    </div>\r\n                                    <div className=\"flex-1 min-w-0\">\r\n                                        <p className=\"text-xs font-bold text-[#3a2d23] truncate\">{item.name}</p>\r\n                                        <p className=\"text-[10px] text-[#3a2d23]/60\">\r\n                                            {item.selectedSize} / <span className=\"inline-block w-2 h-2 rounded-full\" style={{ backgroundColor: item.selectedColor }}></span>\r\n                                        </p>\r\n                                        <p className=\"text-xs font-bold text-[#b1121a]\">\r\n                                            {item.salePrice.toLocaleString()} ├ù {item.quantity}\r\n                                        </p>\r\n                             