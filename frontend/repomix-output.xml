                          <div className="space-y-1 col-span-1">
                            <Label>Icon</Label>
                            <select
                              id="new-social-icon"
                              className="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                            >
                              <option value="Facebook">Facebook</option>
                              <option value="Instagram">Instagram</option>
                              <option value="Twitter">Twitter</option>
                              <option value="Youtube">Youtube</option>
                              <option value="MapPin">Location (MapPin)</option>
                              <option value="Phone">Phone</option>
                              <option value="Mail">Email</option>
                              <option value="Globe">Website (Globe)</option>
                            </select>
                          </div>
                          <div className="space-y-1 col-span-2">
                            <Label>URL</Label>
                            <div className="flex gap-2">
                              <Input id="new-social-url" placeholder="https://..." className="flex-1" />
                              <Button
                                variant="secondary"
                                onClick={() => {
                                  const platformInput = document.getElementById('new-social-platform') as HTMLInputElement;
                                  const urlInput = document.getElementById('new-social-url') as HTMLInputElement;
                                  const iconInput = document.getElementById('new-social-icon') as HTMLSelectElement;

                                  if (platformInput.value && urlInput.value) {
                                    const newLink = {
                                      id: Date.now().toString(),
                                      platform: platformInput.value,
                                      url: urlInput.value,
                                      icon: iconInput.value
                                    };
                                    const currentLinks = Array.isArray(settings.socialLinks) ? settings.socialLinks : [];
                                    updateSettings(prev => ({ ...prev, socialLinks: [...currentLinks, newLink] }));

                                    // Clear inputs
                                    platformInput.value = '';
                                    urlInput.value = '';
                                    toast({ title: "Link Added", description: `${newLink.platform} added successfully.` });
                                  } else {
                                    toast({ title: "Error", description: "Platform and URL are required.", variant: "destructive" });
                                  }
                                }}
                              >
                                Add
                              </Button>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </CardContent>
                </Card>
              )}
              {settingsTab === 'theme' && (
                <Card>
                  <CardHeader>
                    <CardTitle>{t('admin_theme_colors')}</CardTitle>
                  </CardHeader>
                  <CardContent className="space-y-6">
                    <div className="flex items-center justify-between bg-muted/30 p-4 rounded-lg border border-border">
                      <div className="space-y-1">
                        <h4 className="font-semibold text-sm">Reset Theme</h4>
                        <p className="text-xs text-muted-foreground">Restore default "Modern Atelier" colors.</p>
                      </div>
                      <Button
                        variant="secondary"
                        size="sm"
                        onClick={() => {
                          // Force reset
                          updateSettings(prev => ({
                            ...prev,
                            theme: {
                              primary: "#1C1917", // Warm Black
                              primaryHover: "#44403C", // Dark Stone
                              bg: "#FAFAF9", // Warm Stone
                              text: "#1C1917", // Warm Black
                              border: "#E7E5E4", // Warm Grey
                              card: "#FFFFFF", // White
                            }
                          }));
                          toast({ title: "Theme Reset", description: "Default colors restored." });
                          setTimeout(() => window.location.reload(), 1000);
                        }}
                      >
                        <RotateCcw className="mr-2 h-3 w-3" /> {t('admin_reset_default')}
                      </Button>
                    </div>

                    <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                      <div className="space-y-4">
                        <div className="space-y-2">
                          <Label>{t('admin_primary_color')}</Label>
                          <div className="flex gap-2">
                            <Input
                              type="color"
                              className="w-12 h-10 p-1 cursor-pointer"
                              value={settings.theme.primary}
                              onChange={(e) => updateSettings(prev => ({ ...prev, theme: { ...prev.theme, primary: e.target.value } }))}
                            />
                            <Input
                              value={settings.theme.primary}
                              onChange={(e) => updateSettings(prev => ({ ...prev, theme: { ...prev.theme, primary: e.target.value } }))}
                              className="font-mono uppercase"
                            />
                          </div>
                        </div>
                        <div className="space-y-2">
                          <Label>{t('admin_bg_color')}</Label>
                          <div className="flex gap-2">
                            <Input
                              type="color"
                              className="w-12 h-10 p-1 cursor-pointer"
                              value={settings.theme.bg}
                              onChange={(e) => updateSettings(prev => ({ ...prev, theme: { ...prev.theme, bg: e.target.value } }))}
                            />
                            <Input
                              value={settings.theme.bg}
                              onChange={(e) => updateSettings(prev => ({ ...prev, theme: { ...prev.theme, bg: e.target.value } }))}
                              className="font-mono uppercase"
                            />
                          </div>
                        </div>
                      </div>
                    </div>
                  </CardContent>
                </Card>
              )}
            </div>
          )
        }
      </main >

      {/* Product Form Modal */}
      {
        (isAdding || editingProduct) && (
          <ProductForm
            product={editingProduct}
            isAdding={isAdding}
            onSave={(product) => {
              if (editingProduct) {
                // Edit existing product
                setProducts(prev => prev.map(p => p.id === product.id ? product : p));
                toast({
                  title: "Product Updated",
                  description: `${product.name} has been updated successfully.`,
                });
              } else {
                // Add new product
                setProducts(prev => [...prev, product]);
                toast({
                  title: "Product Added",
                  description: `${product.name} has been added to inventory.`,
                });
              }
              setEditingProduct(null);
              setIsAdding(false);
            }}
            onCancel={() => {
              setEditingProduct(null);
              setIsAdding(false);
            }}
          />
        )
      }
    </div >
  );
};

export default AdminDashboard;
</file>

<file path="src/components/AnnouncementMarquee.tsx">
import * as React from 'react';
import { EditableText } from './ui/editable-text';

interface AnnouncementMarqueeProps {
    textKey: string;
}

/**
 * GPU-optimized marquee component using CSS-only animation.
 * - Uses transform: translate3d for GPU acceleration
 * - Pauses on hover
 * - Respects prefers-reduced-motion
 * - No JS timers or intervals
 */
const AnnouncementMarquee: React.FC<AnnouncementMarqueeProps> = React.memo(({ textKey }) => {
    // Check for performance mode on mount
    const isPerf = React.useMemo(() =>
        typeof document !== 'undefined' && document.documentElement.classList.contains('perf'),
        []);

    if (isPerf) {
        return (
            <div className="bg-secondary text-secondary-foreground py-1.5 text-center">
                <span className="text-[10px] md:text-xs font-bold uppercase tracking-widest">
                    <EditableText k={textKey} as="span" />
                </span>
            </div>
        );
    }

    return (
        <div className="marquee bg-secondary text-secondary-foreground overflow-hidden">
            <div className="marquee__track">
                <span className="marquee__item"><EditableText k={textKey} as="span" /></span>
                <span className="marquee__item"><EditableText k={textKey} as="span" /></span>
                <span className="marquee__item"><EditableText k={textKey} as="span" /></span>
                <span className="marquee__item"><EditableText k={textKey} as="span" /></span>
                <span className="marquee__item"><EditableText k={textKey} as="span" /></span>
                <span className="marquee__item"><EditableText k={textKey} as="span" /></span>
            </div>
        </div>
    );
});

AnnouncementMarquee.displayName = 'AnnouncementMarquee';

export default AnnouncementMarquee;
