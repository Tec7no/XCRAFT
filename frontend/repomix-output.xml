import * as React from 'react';
import { useNavigate, useSearchParams, useParams } from 'react-router-dom';
import { Product, CartItem, Order, User } from '../types';
import { INITIAL_PRODUCTS } from '../constants';
import { useStorageState, isValidEgyptianPhone, generateOrderId } from '../utils/storage';
import { useToast } from '@/hooks/use-toast';
import { useLanguage } from '@/i18n/LanguageContext';
import { useSiteSettings } from '@/config/SiteSettingsContext';
import { EditableText } from '../components/ui/editable-text';
import { EditableSection } from '../components/ui/editable-section';
import { useCart } from '@/context/CartContext';
import { useWishlist } from '@/context/WishlistContext';
import { useUI } from '@/context/UIContext';

import WebGLHero from '../components/WebGLHero';
import Header from '../components/Header';
import Footer from '../components/Footer';
import BottomNav from '../components/BottomNav';
import FeaturedSection from '../components/FeaturedSection';
import CategorySection from '../components/CategorySection';
import BestSellersSection from '../components/BestSellersSection';
import Breadcrumbs from '../components/ui/breadcrumbs';
import ProductCard from '../components/ui/product-card-1';
import FiltersSidebar from '../components/filters/FiltersSidebar';
import FiltersPopover from '../components/filters/FiltersPopover';
import {
  FilterState,
  initialFilterState,
  getMinMaxPrice,
  getUniqueCategories,
  getUniqueSizes,
  getUniqueColors
} from '../components/filters/filter-utils';
import ErrorBoundary from '../components/ErrorBoundary';
import AnimatedShaderBackground from '../components/ui/animated-shader-background';
import ScrollReveal from '../components/ui/scroll-reveal';

// Lazy load heavy components
const CartDrawer = React.lazy(() => import('../components/CartDrawer'));
const AuthPage = React.lazy(() => import('../components/AuthPage'));
const AdminDashboard = React.lazy(() => import('../components/AdminDashboard'));
const ProductModal = React.lazy(() => import('../components/ProductModal'));
const WishlistView = React.lazy(() => import('../components/WishlistView'));
const UserOrders = React.lazy(() => import('../components/UserOrders'));

// ... (inside component)




type View = 'home' | 'collection' | 'product' | 'auth' | 'admin' | 'wishlist' | 'orders';

interface IndexProps {
  onToggleCompare?: (product: Product) => void;
  compareList?: Product[];
}

const Index: React.FC<IndexProps> = ({ onToggleCompare, compareList }) => {
  const navigate = useNavigate();
  const { category: urlCategory } = useParams(); // Get category from URL
  const { toast } = useToast();
  const { t, lang } = useLanguage();
  const { settings } = useSiteSettings();


  // State
  const [view, setView] = React.useState<View>('home');
  const [products, setProducts] = useStorageState<Product[]>('products', INITIAL_PRODUCTS);
  // const [cart, setCart] = useStorageState<CartItem[]>('cart', []); // Removed
  const [orders, setOrders] = useStorageState<Order[]>('orders', []);
  // const [wishlist, setWishlist] = useStorageState<string[]>('wishlist', []); // Removed
  const [user, setUser] = useStorageState<User | null>('user', null);
  const [recentlyViewed, setRecentlyViewed] = useStorageState<string[]>('recentlyViewed', []);

  // Contexts
  const { cart, addToCart, removeFromCart, updateQuantity } = useCart();
  const { wishlist, toggleWishlist, isInWishlist } = useWishlist();
  const { openCart, closeCart, openWishlist } = useUI();

  // Filter State
  const [draftFilters, setDraftFilters] = React.useState<FilterState>(initialFilterState);
  const [appliedFilters, setAppliedFilters] = React.useState<FilterState>(initialFilterState);
  const [maxPrice, setMaxPrice] = React.useState(10000);

  // Search State via URL
  const [searchParams, setSearchParams] = useSearchParams();
  const searchQuery = searchParams.get('q') || '';

  const handleSearchChange = (query: string) => {
    if (query) {
      setSearchParams({ q: query }, { replace: true });
    } else {
      setSearchParams({}, { replace: true });
    }
  };

  // Derived Data for Filters
  const availableCategories = React.useMemo(() => getUniqueCategories(products), [products]);
  const availableSizes = React.useMemo(() => getUniqueSizes(products), [products]);
  const availableColors = React.useMemo(() => getUniqueColors(products), [products]);

  React.useEffect(() => {
    const [min, max] = getMinMaxPrice(products);
    setMaxPrice(max);
    // Initialize price filter if zero
    if (appliedFilters.price[1] === 10000 && max > 0) { // arbitrary check
      setDraftFilters(prev => ({ ...prev, price: [0, max] as [number, number] }));
      setAppliedFilters(prev => ({ ...prev, price: [0, max] as [number, number] }));
    }
  }, [products]);

  // Sync URL Category with Filters
  React.useEffect(() => {
    if (urlCategory) {
      // If URL has a category (e.g. /shop/men), allow case-insensitive matching
      // Capitalize first letter basic normalization
      const normalizedCategory = urlCategory.charAt(0).toUpperCase() + urlCategory.slice(1).toLowerCase();

      const newFilters = {
        ...initialFilterState,
        price: [0, maxPrice] as [number, number],
        categories: [normalizedCategory]
      };

      setDraftFilters(newFilters);
      setAppliedFilters(newFilters);

      // Auto-switch to collection/home view if not already there
      if (view !== 'home' && view !== 'collection') {
        setView('home');
      }

      // Attempt to scroll to products section
      setTimeout(() => {
        document.getElementById('products')?.scrollIntoView({ behavior: 'smooth' });
      }, 100);
    }
  }, [urlCategory, maxPrice]); // Re-run when URL category changes


  const [selectedProduct, setSelectedProduct] = React.useState<Product | null>(null);
  const [quickViewProduct, setQuickViewProduct] = React.useState<Product | null>(null);
  // const [isCartOpen, setIsCartOpen] = React.useState(false); // Removed
  // const [searchQuery, setSearchQuery] = React.useState(''); // Removed local state

  // Filtered products
  const filteredProducts = React.useMemo(() => {
    return products.filter(p => {
      // 1. Search (Always global)
      if (searchQuery && !p.name.toLowerCase().includes(searchQuery.toLowerCase())) return false;

      // 2. Categories
      // Support special "New" and "Offers" as categories if they come from buttons, 
      // OR standard categories if from filter.
      // logic: if appliedFilters.categories has items, p.category must be in it OR p.badge matches special ones.
      if (appliedFilters.categories.length > 0) {
        let matches = false;
        if (appliedFilters.categories.includes(p.category)) matches = true;
        // Special mapping for New/Offers if the user selects them as "Categories"
        if (appliedFilters.categories.includes('New') && p.badge === 'New') matches = true;
        if (appliedFilters.categories.includes('Offers') && (p.discount > 0 || p.badge === 'Sale')) matches = true;

        if (!matches) return false;
      }

      // 3. Price
      if (p.salePrice < appliedFilters.price[0] || p.salePrice > appliedFilters.price[1]) return false;

      // 4. Sizes
      if (appliedFilters.sizes.length > 0) {
        const hasSize = (p.sizes ?? []).some(s =>
          appliedFilters.sizes.includes(typeof s === 'string' ? s : (s as { label: string }).label)
        );
        if (!hasSize) return false;
      }

      // 5. Colors
      if (appliedFilters.colors.length > 0) {
        const hasColor = p.colors.some(c => appliedFilters.colors.includes(c.hex));
        if (!hasColor) return false;
      }

      // 6. In Stock
      if (appliedFilters.inStockOnly && p.stock <= 0) return false;

      return true;
    });
  }, [products, searchQuery, appliedFilters]);

  // Handlers
  const handleApplyFilters = () => {
    setAppliedFilters(draftFilters);
  };

  const handleClearFilters = () => {
    const cleared = { ...initialFilterState, price: [0, maxPrice] as [number, number] };
    setDraftFilters(cleared);
    setAppliedFilters(cleared);
  };

  const handleNavigate = (category: string | null) => {
    // When clicking a category chip, we set that category as the ONLY drafted/applied filter and scroll
    if (category) {
      const newFilters = {
        ...initialFilterState,
        price: [0, maxPrice] as [number, number],
        categories: [category]
      };
      setDraftFilters(newFilters);
      setAppliedFilters(newFilters);

      setView('home');
      setTimeout(() => {
        document.getElementById('products')?.scrollIntoView({ behavior: 'smooth' });
      }, 100);
    } else {
      // Clear all
      handleClearFilters();
      window.scrollTo(0, 0);
    }
  };

  const handleProductClick = (product: Product) => {
    setSelectedProduct(product);
    setView('product');
    setRecentlyViewed(prev => {
      const filtered = prev.filter(id => id !== product.id);
      return [product.id, ...filtered].slice(0, 10);
    });
    window.scrollTo(0, 0);
  };

  const handleCheckout = () => {
    // setIsCartOpen(false); // Handled by context
    navigate('/checkout');
  };

  const handleLogin = (loggedInUser: User) => {
    setUser(loggedInUser);
    if (loggedInUser.role === 'admin' || loggedInUser.role === 'manager') {
      setView('admin');
    } else {
      setView('home');
    }
    toast({ title: 'Welcome!', description: `Logged in as ${loggedInUser.name}` });
  };

  const handleLogout = () => {
    setUser(null);
    setView('home');
  };

  const getStock = (productId: string) => products.find(p => p.id === productId)?.stock || 0;

  const handleScrollToFeatured = () => {
    const element = document.getElementById('home-products');
    if (element) {
      element.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  };

  // Render based on view
  if (view === 'auth') {
    return (
      <React.Suspense fallback={<div className="min-h-screen" />}>
        <AuthPage onLogin={handleLogin} onCancel={() => setView('home')} />
      </React.Suspense>
    );
  }

  if (view === 'admin' && user && (user.role === 'admin' || user.role === 'manager')) {
    return (
      <React.Suspense fallback={<div className="min-h-screen flex items-center justify-center">Loading Admin...</div>}>
        <AdminDashboard
          onExit={handleLogout}
          userRole={user.role}
          products={products}
          setProducts={setProducts}
          orders={orders}
          setOrders={setOrders}
        />
      </React.Suspense>
    );
  }

  // Fixing the ProductPage import issue by declaring it if missed
  const ProductPage = React.lazy(() => import('../components/ProductPage'));

  if (view === 'product' && selectedProduct) {
    return (
      <ErrorBoundary>
        <Header
          onSearchChange={handleSearchChange}
          onNavigate={handleNavigate}
          onAccount={() => setView('auth')}
          onLogout={handleLogout}
          onOrders={() => setView('orders')}
          user={user}
        />
        <React.Suspense fallback={<div className="min-h-screen" />}>
          <ProductPage
            product={selectedProduct}
            onBack={() => setView('home')} // Back goes to home
            onAddToCart={(p, color, size) => addToCart(p, color, size, 1)}
            onProductClick={handleProductClick}
            recentlyViewedIds={recentlyViewed}
            isWishlisted={wishlist.includes(selectedProduct.id)}
            onToggleWishlist={() => toggleWishlist(selectedProduct.id)}
            catalog={products}
          />
        </React.Suspense>
      </ErrorBoundary>
    );
  }

  return (
    <ErrorBoundary>
      <AnimatedShaderBackground />
      <div className="min-h-screen flex flex-col pb-16 md:pb-0 relative">
        <div className="absolute top-0 w-full z-50">
          <Header
            onSearchChange={handleSearchChange}
            onNavigate={handleNavigate}
            onAccount={() => setView('auth')}
            onLogout={handleLogout}
            onOrders={() => setView('orders')}
            user={user}
          />
        </div>

        <main className="flex-grow">
          {view === 'home' && (
            <>
              <WebGLHero onNavigate={handleNavigate} />
              <section key="products" id="products" className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 min-h-screen">
                <ScrollReveal variant="fadeUp">
                  <div className="flex flex-col items-center mb-8">
                    {/* Breadcrumbs for category view */}
                    <div className="mb-4">
                      <Breadcrumbs
                        items={[
                          { label: <EditableText k="shop_home" as="span" />, onClick: () => navigate('/') },
                          ...(appliedFilters.categories.length === 1 ? [{ label: appliedFilters.categories[0] }] : [{ label: <EditableText k="shop_shop" as="span" /> }])
                        ]}
                      />
                    </div>

                    <h2 className="text-3xl font-black text-foreground uppercase tracking-tighter text-center">
                      {appliedFilters.categories.length === 1 ? (
                        <span>{appliedFilters.categories[0]} <span className="text-muted-foreground text-xl"><EditableText k="shop_collection" as="span" /></span></span>
                      ) : (
                        <span><EditableText k="shop_full_collection" as="span" /></span>
                      )}
                    </h2>

                    {(appliedFilters.categories.length > 0 || appliedFilters.price[1] < maxPrice) && (
                      <div className="mt-2 text-sm text-[#b1121a]"></div>
                    )}
                  </div>
                </ScrollReveal>

                <div className="md:hidden flex justify-between items-center mb-4">
                  <span className="text-sm text-[#3a2d23] font-bold">
                    {filteredProducts.length} <EditableText k="shop_results" as="span" />
                  </span>
                  <FiltersPopover
                    filters={draftFilters}
                    setFilters={setDraftFilters}
                    availableCategories={availableCategories}
                    availableSizes={availableSizes}
                    availableColors={availableColors}
                    maxPrice={maxPrice}
                    onApply={handleApplyFilters}
                    onClear={handleClearFilters}
                  />
                </div>

                <div className="flex flex-col md:flex-row gap-8 align-start">
                  <FiltersSidebar
                    filters={draftFilters}
                    setFilters={setDraftFilters}
                    availableCategories={availableCategories}
                    availableSizes={availableSizes}
                    availableColors={availableColors}
                    maxPrice={maxPrice}
                    onApply={handleApplyFilters}
                    onClear={handleClearFilters}
                  />

                  <div className="flex-1">
                    {filteredProducts.length > 0 ? (
                      <div className="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-3 gap-3 md:gap-6">
                        {filteredProducts.map((product, index) => (
                          <ScrollReveal key={product.id} variant="fadeUp" delay={index * 0.05}>
                            <ProductCard
                              product={product}
                              onClick={handleProductClick}
                              onAddToCart={(p, c, s) => {
                                addToCart(p, c || '', s || '');
                                toast({ title: 'Added to bag', description: `${p.name} added to your bag.` });
                              }}
                              onQuickView={setQuickViewProduct}
                              onToggleWishlist={() => toggleWishlist(product.id)}
                              isWishlisted={isInWishlist(product.id)}
                            />
                          </ScrollReveal>
                        ))}
                      </div>
                    ) : (
                      <div className="text-center py-20 text-muted-foreground bg-[#f6efea]/50 rounded-lg border border-[#d8c6bb]">
                        <p><EditableText k="filters_noResults" as="span" /></p>
                        <button onClick={handleClearFilters} className="mt-4 text-[#b1121a] underline font-bold">
                          <EditableText k="filters_clear" as="span" />
                        </button>
                      </div>
                    )}
                  </div>
                </div>
              </section>
            </>
          )}

          {view === 'wishlist' && (
            <React.Suspense fallback={<div className="py-20 text-center">Loading Wishlist...</div>}>
              <WishlistView
                wishlist={wishlist}
                products={products}
                onSetView={setView}
                onProductClick={handleProductClick}
                onAddToCart={(p, qty) => {
                  addToCart(p); // default qty 1 if not supported, or loop
                  toast({ title: 'Added to bag' });
                }}
                onQuickView={setQuickViewProduct}
                onToggleWishlist={(p) => toggleWishlist(p.id)}
              />
            </React.Suspense>
          )}

          {view === 'orders' && user && (
            <React.Suspense fallback={<div className="py-20 text-center">Loading Orders...</div>}>
              <UserOrders
                orders={orders}
                user={user}
                onBack={() => setView('home')}
              />
            </React.Suspense>
          )}
        </main>

        <Footer onNavigate={handleNavigate} />

        <BottomNav
          activeView={view}
          onNavigate={(v) => {
            if (v === 'collection') { handleNavigate(null); }
            else { setView(v); }
          }}
          onAccount={() => setView('auth')}
          onOpenCart={openCart}
          onWishlist={openWishlist}
          cartCount={cart.reduce((acc, item) => acc + item.quantity, 0)}
        />

        <React.Suspense fallback={null}>
          <ProductModal
            product={quickViewProduct}
            isOpen={!!quickViewProduct}
            onClose={() => setQuickViewProduct(null)}
            onAddToCart={(p, color, size) => {
              addToCart(p, color, size);
              toast({ title: 'Added to bag' });
            }}
          />
          {/* CartDrawer is Global now */}
        </React.Suspense>
      </div>
    </ErrorBoundary>
  );
};

export default Index;
</file>

