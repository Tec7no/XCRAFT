<file path="src/components/AuthPage.tsx">
import * as React from 'react';
import { User, Lock, Mail, ArrowRight, ShieldCheck, UserPlus, Info } from './icons';
import { User as UserType } from '../types';
import { useLanguage } from '@/i18n/LanguageContext';

interface AuthPageProps {
  onLogin: (user: UserType) => void;
  onCancel: () => void;
}

const AuthPage: React.FC<AuthPageProps> = ({ onLogin, onCancel }) => {
  const [mode, setMode] = React.useState<'login' | 'signup' | 'staff'>('login');
  const [email, setEmail] = React.useState('');
  const [password, setPassword] = React.useState('');
  const [name, setName] = React.useState('');
  const [error, setError] = React.useState('');
  const { t } = useLanguage();

  const handleStaffLogin = (e: React.FormEvent) => {
    e.preventDefault();
    const normalizedEmail = email.trim().toLowerCase();

    if (normalizedEmail === 'admin@demo.com' && password === 'Admin@12345') {
      onLogin({ id: 'staff-admin', name: 'Demo Admin', email: normalizedEmail, role: 'admin' });
    } else {
      setError('Invalid staff credentials. Please use the demo admin login.');
    }
  };

  const handleCustomerAuth = (e: React.FormEvent) => {
    e.preventDefault();
    if (mode === 'signup' && !name) {
      setError('Please enter your full name.');
      return;
    }

    const normalizedEmail = email.trim().toLowerCase();
    onLogin({
      id: Math.random().toString(36).substr(2, 9),
      name: name || normalizedEmail.split('@')[0],
      email: normalizedEmail,
      role: 'customer'
    });
  };

  return (
    <div className="min-h-[85vh] flex items-center justify-center px-4 py-16 bg-muted">
      <div className="max-w-md w-full bg-card border border-border p-8 md:p-12 shadow-2xl rounded-2xl animate-fade-in-up relative overflow-hidden">
        {mode === 'staff' && (
          <div className="absolute top-0 left-0 w-full h-1.5 bg-secondary" />
        )}

        <div className="text-center mb-10">
          <h2 className="text-3xl font-black uppercase tracking-tighter text-primary mb-2">
            {mode === 'staff' ? t('auth_staff_portal') : mode === 'login' ? t('auth_welcome') : t('auth_join')}
          </h2>
          <p className="text-muted-foreground text-[10px] font-black uppercase tracking-widest">
            {mode === 'staff' ? t('auth_internal_access') : t('auth_official_access')}
          </p>
        </div>

        {error && (
          <div className="mb-8 p-4 bg-destructive/10 border border-destructive/20 text-destructive text-[10px] font-black uppercase text-center tracking-widest rounded flex items-center justify-center gap-2">
            <Info size={14} /> {error}
          </div>
        )}

        <form onSubmit={mode === 'staff' ? handleStaffLogin : handleCustomerAuth} className="space-y-6">
          {mode === 'signup' && (
            <div className="relative">
              <User className="absolute left-4 top-1/2 -translate-y-1/2 text-muted-foreground" size={18} />
              <input
                type="text"
                placeholder={t('auth_placeholder_name')}
                value={name}
                onChange={(e) => setName(e.target.value)}
                className="w-full bg-muted border border-border pl-12 pr-4 py-4 text-xs font-bold text-primary outline-none focus:border-secondary tracking-wide transition-colors rounded-xl"
                required
              />
            </div>
          )}

          <div className="relative">
            <Mail className="absolute left-4 top-1/2 -translate-y-1/2 text-muted-foreground" size={18} />
            <input
              type="email"
              placeholder={t('auth_placeholder_email')}
              value={email}
              onChange={(e) => setEmail(e.target.value)}
              className="w-full bg-muted border border-border pl-12 pr-4 py-4 text-xs font-bold text-primary outline-none focus:border-secondary tracking-wide transition-colors rounded-xl"
              required
            />
          </div>

          <div className="relative">
            <Lock className="absolute left-4 top-1/2 -translate-y-1/2 text-muted-foreground" size={18} />
            <input
              type="password"
              placeholder={t('auth_placeholder_password')}
              value={password}
              onChange={(e) => setPassword(e.target.value)}
              className="w-full bg-muted border border-border pl-12 pr-4 py-4 text-xs font-bold text-primary outline-none focus:border-secondary tracking-wide transition-colors rounded-xl"
              required
            />
          </div>

          <button
            type="submit"
            className={`w-full py-5 font-black uppercase text-xs tracking-[0.2em] transition-all shadow-xl flex items-center justify-center gap-3 rounded-xl ${mode === 'staff' ? 'bg-primary text-primary-foreground hover:bg-secondary' : 'bg-secondary text-secondary-foreground hover:bg-primary'
              }`}
          >
            {mode === 'signup' ? t('auth_btn_signup') : mode === 'staff' ? t('auth_btn_staff_login') : t('auth_btn_login')} <ArrowRight size={18} />
          </button>
        </form>

        <div className="mt-10 pt-8 border-t border-border flex flex-col gap-5">
          {mode !== 'staff' ? (
            <>
              <button
                onClick={() => { setMode(mode === 'login' ? 'signup' : 'login'); setError(''); }}
                className="text-[10px] font-black text-muted-foreground hover:text-secondary uppercase tracking-widest transition-colors flex items-center justify-center gap-2"
              >
                {mode === 'login' ? <><UserPlus size={14} /> {t('auth_link_new')}</> : t('auth_link_existing')}
              </button>
              <button
                onClick={() => { setMode('staff'); setError(''); }}
                className="text-[10px] font-black text-secondary hover:text-primary uppercase tracking-widest transition-colors flex items-center justify-center gap-2"
              >
                <ShieldCheck size={14} /> {t('auth_link_staff')}
              </button>
            </>
          ) : (
            <button
              onClick={() => { setMode('login'); setError(''); }}
              className="text-[10px] font-black text-muted-foreground hover:text-primary uppercase tracking-widest transition-colors flex items-center justify-center gap-2"
            >
              <ArrowRight size={14} className="rotate-180" /> {t('auth_link_customer')}
            </button>
          )}

          <button
            onClick={onCancel}
            className="text-[10px] font-black text-muted-foreground/50 hover:text-muted-foreground uppercase tracking-widest transition-colors mt-2"
          >
            {t('auth_guest')}
          </button>
        </div>

        {mode === 'staff' && (
          <div className="mt-8 p-4 bg-muted rounded-lg border border-border">
            <p className="text-[9px] font-black uppercase text-muted-foreground tracking-widest mb-3 flex items-center gap-2">
              <Info size={12} /> {t('auth_portal_guide')}
            </p>
            <div className="space-y-2 text-[8px] font-bold text-muted-foreground uppercase tracking-tight">
              <div className="flex justify-between"><span>{t('auth_admin_label')}</span> <span>admin@demo.com / Admin@12345</span></div>
            </div>
          </div>
        )}
      </div>
    </div>
  );
};

export default AuthPage;
</file>

<file path="src/components/BestSellersSection.tsx">
import * as React from 'react';
import { Product } from '../types';
import ProductCard from './ui/product-card-1';
import { useLanguage } from '@/i18n/LanguageContext';
import ScrollReveal from './ui/scroll-reveal';
import { EditableSection } from './ui/editable-section';
import { EditableText } from './ui/editable-text';

interface BestSellersSectionProps {
    products: Product[];
    onProductClick: (product: Product) => void;
    onAddToCart: (product: Product, quantity: number) => void;
    onToggleWishlist: (product: Product) => void;
    wishlist: string[];
    setQuickViewProduct: (product: Product) => void;
}

const BestSellersSection: React.FC<BestSellersSectionProps> = ({
    products,
    onProductClick,
    onAddToCart,
    onToggleWishlist,
    wishlist,
    setQuickViewProduct
}) => {
    const { t } = useLanguage();

    const bestSellers = React.useMemo(() => {
        return products.slice(4, 8);
    }, [products]);

    return (
        <EditableSection id="bestSellers" title="Best Sellers">
            <section className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
                <ScrollReveal variant="fadeUp">
                    <h2 className="text-3xl font-black text-center mb-12 uppercase tracking-tighter">
                        <EditableText k="section_bestSellers" as="span" />
                    </h2>
                </ScrollReveal>

                <div className="grid grid-cols-2 lg:grid-cols-4 gap-6">
                    {bestSellers.map((product, index) => (
                        <ScrollReveal key={product.id} variant="fadeUp" delay={index * 0.1}>
                            <ProductCard
                                product={product}
                                onClick={onProductClick}
                                onAddToCart={(p) => onAddToCart(p, 1)}
                                onQuickView={setQuickViewProduct}
                                onToggleWishlist={onToggleWishlist}
                                isWishlisted={wishlist.includes(product.id)}
                                badgeText={t('badge_bestSeller')}
                                className="bg-zinc-50 border-zinc-200"
                            />
                        </ScrollReveal>
                    ))}
                </div>
            </section>
        </EditableSection>
    );
};

export default BestSellersSection;
</file>

