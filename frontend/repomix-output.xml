ngsContext';\nimport { useLanguage } from '@/i18n/LanguageContext';\n\nconst AdminDashboard: React.FC<AdminDashboardProps> = ({ onExit, userRole, products, setProducts, orders, setOrders }) => {\n  const navigate = useNavigate();\n  const { toast } = useToast();\n  const { settings, updateSettings } = useSiteSettings();\n  const { lang } = useLanguage();\n  const [activeTab, setActiveTab] = React.useState<AdminTab>('overview');\n  const [discounts, setDiscounts] = useStorageState<Discount[]>('discounts', []);\n  const [search, setSearch] = React.useState('');\n  const [editingProduct, setEditingProduct] = React.useState<Product | null>(null);\n  const [isAdding, setIsAdding] = React.useState(false);\n  const [imageUrlInput, setImageUrlInput] = React.useState('');\n  const [selectedOrder, setSelectedOrder] = React.useState<Order | null>(null);\n  const [orderTab, setOrderTab] = React.useState('under_review');\n  const [orderToDelete, setOrderToDelete] = React.useState<string | null>(null);\n  const [orderToArchive, setOrderToArchive] = React.useState<{ id: string, archive: boolean } | null>(null);\n  const modalRef = React.useRef<HTMLFormElement | null>(null);\n  const lastFocusedRef = React.useRef<HTMLElement | null>(null);\n\n  const canAdd = userRole === 'admin' || userRole === 'manager';\n  const canEdit = userRole === 'admin' || userRole === 'manager';\n  const canDelete = userRole === 'admin';\n\n  const stats = React.useMemo(() => ({\n    totalProducts: products.length,\n    lowStock: products.filter(p => p.stock < 10).length,\n    totalValue: products.reduce((acc, p) => acc + (p.salePrice * p.stock), 0),\n    categories: new Set(products.map(p => p.category)).size,\n    totalOrders: orders.length,\n    pendingOrders: orders.filter((order) => order.status === 'pending_review').length\n  }), [orders, products]);\n\n  const categoryStats = React.useMemo(() => {\n    const map = new Map<string, { count: number; value: number }>();\n    products.forEach(p => {\n      const current = map.get(p.category) || { count: 0, value: 0 };\n      map.set(p.category, {\n        count: current.count + 1,\n        value: current.value + (p.salePrice * p.stock)\n      });\n    });\n    return Array.from(map.entries()).map(([name, data]) => ({ name, ...data }));\n  }, [products]);\n\n  const filteredProducts = products.filter(p =>\n    p.name.toLowerCase().includes(search.toLowerCase()) ||\n    p.code.toLowerCase().includes(search.toLowerCase())\n  );\n\n  const getOrderCounts = React.useMemo(() => {\n    return {\n      under_review: orders.filter(o => !o.archived && o.status === 'pending_review').length,\n      active: orders.filter(o => !o.archived && ['accepted', 'preparing', 'shipping'].includes(o.status)).length,\n      delivered: orders.filter(o => !o.archived && o.status === 'delivered').length,\n      rejected: orders.filter(o => !o.archived && o.status === 'rejected').length,\n      all: orders.filter(o => !o.archived).length,\n      archived: orders.filter(o => o.archived).length,\n    };\n  }, [orders]);\n\n  const filteredOrders = React.useMemo(() => {\n    let base = orders;\n\n    // Filter by tab\n    if (orderTab === 'under_review') base = base.filter(o => !o.archived && o.status === 'pending_review');\n    else if (orderTab === 'active') base = base.filter(o => !o.archived && ['accepted', 'preparing', 'shipping'].includes(o.status));\n    else if (orderTab === 'delivered') base = base.filter(o => !o.archived && o.status === 'delivered');\n    else if (orderTab === 'rejected') base = base.filter(o => !o.archived && o.status === 'rejected');\n    else if (orderTab === 'archived') base = base.filter(o => o.archived);\n    else if (orderTab === 'all') base = base.filter(o => !o.archived);\n\n    // Search filter\n    if (search) {\n      const s = search.toLowerCase();\n      base = base.filter(o =>\n        o.id.toLowerCase().includes(s) ||\n        (o.customer?.fullName ?? '').toLowerCase().includes(s) ||\n        o.status.toLowerCase().includes(s)\n      );\n    }\n\n    // Default Sort (Newest first)\n    return [...base].sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());\n  }, [orders, orderTab, search]);\n\n  const handlePermanentDelete = () => {\n    if (!orderToDelete) return;\n    if (deleteOrderFromStore(orderToDelete)) {\n      setOrders(prev => prev.filter(o => o.id !== orderToDelete));\n      if (selectedOrder?.id === orderToDelete) setSelectedOrder(null);\n      toast({ title: \"Order Deleted\", description: \"The order has been permanently removed.\" });\n    }\n    setOrderToDelete(null);\n  };\n\n  const handleToggleArchive = (id: string, archive: boolean) => {\n    const updated = archiveOrderFromStore(id, archive);\n    if (updated) {\n      setOrders(prev => prev.map(o => o.id === id ? updated : o));\n      if (selectedOrder?.id === id) {\n        if (archive) setSelectedOrder(null);\n        else setSelectedOrder(updated);\n      }\n      toast({\n        title: archive ? \"Order Archived\" : \"Order Restored\",\n        description: archive ? \"Order moved to archived tab.\" : \"Order returned to list.\"\n      });\n    }\n  };\n\n  const lowStockProducts = products.filter(p => p.stock < 10);\n\n  const updateOrderStatus = (id: string, status: OrderStatus) => {\n    setOrders((prev) => prev.map((order) => (order.id === id ? { ...order, status } : order)));\n  };\n\n  const handleDelete = (id: string) => {\n    if (!canDelete) return;\n    if (window.confirm('Are you sure you want to remove this product?')) {\n      setProducts(prev => prev.filter(p => p.id !== id));\n    }\n  };\n\n  const handleImageUpload = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const files = e.target.files;\n    if (!files || !editingProduct) return;\n\n    Array.from(files).forEach(file => {\n      const reader = new FileReader();\n      reader.onloadend = () => {\n        const base64String = reader.result as string;\n        setEditingProduct(prev => {\n          if (!prev) return prev;\n          if (prev.images.includes(base64String)) return prev;\n          return { ...prev, images: [...prev.images, base64String] };\n        });\n      };\n      reader.readAsDataURL(file);\n    });\n    e.target.value = '';\n  };\n\n  React.useEffect(() => {\n    if (editingProduct) {\n      lastFocusedRef.current = document.activeElement as HTMLElement;\n      const focusable = modalRef.current?.querySelectorAll<HTMLElement>(\n        'button, [href], input, select, textarea, [tabindex]:not([tabindex=\"-1\"])'\n      );\n      focusable?.[0]?.focus();\n    } else {\n      lastFocusedRef.current?.focus?.();\n    }\n  }, [editingProduct]);\n\n  React.useEffect(() => {\n    if (!editingProduct) return;\n    const handleKeyDown = (e: KeyboardEvent) => {\n      if (e.key === 'Escape') {\n        e.stopPropagation();\n        setEditingProduct(null);\n        setIsAdding(false);\n        setImageUrlInput('');\n      }\n    };\n    document.addEventListener('keydown', handleKeyDown);\n    return () => document.removeEventListener('keydown', handleKeyDown);\n  }, [editingProduct]);\n\n  const handleAddImageUrl = () => {\n    if (!editingProduct) return;\n    const trimmed = imageUrlInput.trim();\n    if (!trimmed) return;\n    if (editingProduct.images.includes(trimmed)) {\n      setImageUrlInput('');\n      return;\n    }\n    setEditingProduct({ ...editingProduct, images: [...editingProduct.images, trimmed] });\n    setImageUrlInput('');\n  };\n\n  const handleSave = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!editingProduct) return;\n\n    if (editingProduct.images.length === 0) {\n      alert(\"At least one image is required.\");\n      return;\n    }\n\n    const sanitizedProduct = {\n      ...editingProduct,\n      salePrice: Math.max(0, Number(editingProduct.salePrice) || 0),\n      originalPrice: Math.max(0, Number(editingProduct.originalPrice) || 0),\n      discount: Math.max(0, Number(editingProduct.discount) || 0),\n      stock: Math.max(0, Math.floor(Number(editingProduct.stock) || 0)),\n      colors: editingProduct.colors.filter(Boolean),\n      sizes: editingProduct.sizes.filter(Boolean)\n    };\n\n    if (isAdding) {\n      const newProduct = { ...sanitizedProduct, id: `tt-${Date.now()}` };\n      setProducts(prev => [newProduct, ...prev]);\n    } else {\n      setProducts(prev => prev.map(p => p.id === editingProduct.id ? sanitizedProduct : p));\n    }\n    setEditingProduct(null);\n    setIsAdding(false);\n    setImageUrlInput('');\n  };\n\n  const ProductTable = ({ items, title }: { items: Product[], title: string }) => (\n    <div className=\"bg-card border border-border rounded-lg shadow-sm overflow-hidden\">\n      <div className=\"p-6 border-b border-border bg-muted flex items-center justify-between\">\n        <h3 className=\"text-xs font-black uppercase tracking-widest text-primary\">{title} ({items.length})</h3>\n        {activeTab !== 'inventory' && (\n          <button onClick={() => setActiveTab('overview')} className=\"text-[10px] font-bold uppercase text-muted-foreground hover:text-secondary flex items-center gap-1\">\n            <ArrowLeft size={12} /> Back\n          </button>\n        )}\n      </div>\n      <div className=\"overflow-x-auto\">\n        <table className=\"w-full text-left border-collapse min-w-[800px]\">\n          <thead>\n            <tr className=\"bg-muted border-b border-border\">\n              <th className=\"px-6 py-4 text-[10px] font-black uppercase tracking-widest text-muted-foreground\">Product</th>\n              <th className=\"px-6 py-4 text-[10px] font-black uppercase tracking-widest text-muted-foreground\">SKU</th>\n              <th className=\"px-6 py-4 text-[10px] font-black uppercase tracking-widest text-muted-foreground text-center\">Stock</th>\n              <th className=\"px-6 py-4 text-[10px] font-black uppercase tracking-widest text-muted-foreground text-center\">Status</th>\n              <th className=\"px-6 py-4 text-[10px] font-black uppercase tracking-widest text-muted-foreground text-right\">Price</th>\n              <th className=\"px-6 py-4 text-[10px] font-black uppercase tracking-widest text-muted-foreground text-right\">Actions</th>\n            </tr>\n          </thead>\n          <tbody className=\"divide-y divide-border\">\n            {items.map(p => (\n              <tr key={p.id} className=\"hover:bg-muted transition-colors\">\n                <td className=\"px-6 py-4\">\n                  <div className=\"flex items-center gap-4\">\n                    {p.images.find(Boolean) ? (\n                      <img src={p.images.find(Boolean)} className=\"w-10 h-10 object-cover rounded bg-muted border border-border\" />\n                    ) : (\n                      <ImagePlaceholder className=\"w-10 h-10 rounded bg-muted border border-border\" label=\"No img\" />\n                    )}\n                    <div>\n                      <p className=\"text-xs font-black uppercase text-primary leading-tight\">{p.name}</p>\n                      <p className=\"text-[9px] font-bold text-muted-foreground uppercase\">{p.category}</p>\n                    </div>\n                  </div>\n                </td>\n                <td className=\"px-6 py-4 text-[10px] font-mono font-bold text-muted-foreground\">{p.code}</td>\n                <td className=\"px-6 py-4 text-center\">\n                  <span className={`text-xs font-black ${p.stock < 10 ? 'text-destructive' : 'text-primary'}`}>{p.stock}</span>\n                </td>\n                <td className=\"px-6 py-4 text-center\">\n                  <span className={`px-2 py-1 rounded-full text-[8px] font-black uppercase tracking-widest ${p.stock === 0 ? 'bg-destructive/10 text-destructive' : p.stock < 10 ? 'bg-yellow-100 text-yellow-700' : 'bg-green-100 text-green-700'}`}>\n                    {p.stock === 0 ? 'OOS' : p.stock < 10 ? 'Low' : 'Active'}\n                  </span>\n                </td>\n                <td className=\"px-6 py-4 text-right\">\n                  <p className=\"text-xs font-black text-secondary\">EGP {p.salePrice.toLocaleString()}</p>\n                </td>\n                <td className=\"px-6 py-4 text-right\">\n                  <div className=\"flex justify-end gap-2\">\n                    {canEdit && (\n                      <button\n                        onClick={() => { setIsAdding(false); setEditingProduct(p); }}\n                        className=\"p-2 text-muted-foreground hover:text-primary transition-colors bg-muted rounded\"\n                      >\n                        <Pencil size={14} />\n                      </button>\n                    )}\n                    {canDelete && (\n                      <button\n                        onClick={() => handleDelete(p.id)}\n                        className=\"p-2 text-muted-foreground hover:text-destructive transition-colors bg-muted rounded\"\n                      >\n                        <Trash2 size={14} />\n                      </button>\n                    )}\n                  </div>\n                </td>\n              </tr>\n            ))}\n          </tbody>\n        </table>\n      </div>\n      {items.length === 0 && (\n        <div className=\"p-20 text-center text-muted-foreground uppercase text-[10px] font-black tracking-widest\">\n          No records found.\n        </div>\n      )}\n    </div>\n  );\n\n  const STATUS_COLORS: Record<string, string> = {\n    pending_review: 'bg-yellow-100 text-yellow-700',\n    accepted: 'bg-blue-100 text-blue-700',\n    rejected: 'bg-red-100 text-red-700',\n    preparing: 'bg-purple-100 text-purple-700',\n    shipping: 'bg-orange-100 text-orange-700',\n    delivered: 'bg-green-100 text-green-700',\n  };\n\n  const OrdersView = ({ items }: { items: Order[] }) => {\n    // Grouping logic for \"All\" tab\n    const groupedItems = React.useMemo(() => {\n      if (orderTab !== 'all') return [{ label: '', items }];\n\n      const sequence = ['pending_review', 'accepted', 'preparing', 'shipping', 'delivered', 'rejected'];\n      return sequence.map(status => ({\n        label: status.replace('_', ' ').toUpperCase(),\n        items: items.filter(o => o.status === status)\n      })).filter(g => g.items.length > 0);\n    }, [items, orderTab]);\n\n    return (\n      <div className=\"flex flex-col gap-6 h-[calc(100vh-220px)]\">\n        <Tabs value={orderTab} onValueChange={setOrderTab} className=\"w-full\">\n          <TabsList className=\"grid grid-cols-3 lg:grid-cols-6 h-auto p-1 bg-muted/50 rounded-lg\">\n            {[\n              { id: 'under_review', label: 'Under Review' },\n              { id: 'active', label: 'Active' },\n              { id: 'delivered', label: 'Delivered' },\n              { id: 'rejected', label: 'Rejected' },\n              { id: 'all', label: 'All' },\n              { id: 'archived', label: 'Archived' }\n            ].map(tab => (\n              <TabsTrigger\n                key={tab.id}\n                value={tab.id}\n                className=\"text-[9px] font-black uppercase tracking-widest py-2 rounded-md transition-all data-[state=active]:bg-secondary data-[state=active]:text-secondary-foreground\"\n              >\n                {tab.label}\n                <Badge variant=\"secondary\" className=\"ml-2 h-4 min-w-4 px-1 text-[8px] bg-primary/10 text-primary border-none\">\n                  {getOrderCounts[tab.id as keyof typeof getOrderCounts]}\n                </Badge>\n              </TabsTrigger>\n            ))}\n          </TabsList>\n        </Tabs>\n\n        <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6 flex-1 overflow-hidden\">\n          {/* Orders List */}\n          <div className=\"lg:col-span-1 bg-card border border-border rounded-lg shadow-sm overflow-hidden flex flex-col\">\n            <div className=\"flex-1 overflow-y-auto\">\n              {items.length === 0 ? (\n                <div className=\"p-12 text-center text-muted-foreground uppercase text-[10px] font-black tracking-widest\">\n                  No orders found in this category.\n                </div>\n              ) : (\n                groupedItems.map((group, gIdx) => (\n                  <React.Fragment key={gIdx}>\n                    {group.label && (\n                      <div className=\"bg-muted/40 p-2 px-4 border-y border-border\">\n                        <span className=\"text-[8px] font-black tracking-widest text-muted-foreground uppercase\">\n                          {group.label}\n                        </span>\n                      </div>\n                    )}\n                    <div className=\"divide-y divide-border\">\n                      {group.items.map(order => (\n                        <div key={order.id} className=\"group relative\">\n                          <button\n                            onClick={() => setSelectedOrder(order)}\n                            className={`w-full p-4 text-left hover:bg-muted/50 transition-colors ${selectedOrder?.id === order.id ? 'bg-muted border-l-4 border-l-secondary' : ''\n                              }`}\n                          >\n                            <div className=\"flex justify-between items-start mb-1\">\n                              <p className=\"text-xs font-black text-primary\">{order.id.split('-').slice(0, 2).join('-')}</p>\n                              <span className={`px-2 py-0.5 rounded-full text-[8px] font-black uppercase ${STATUS_COLORS[order.status] || 'bg-gray-100 text-gray-600'}`}>\n                                {(order.status || 'Unknown').replace('_', ' ')}\n                              </span>\n                            </div>\n                            <p className=\"text-[10px] font-bold text-muted-foreground truncate\">\n                              {order.customer?.fullName || 'Legacy Customer'}\n                            </p>\n                            <div className=\"flex justify-bet